----------------------------------------------------------------------
-- executeBefore / requestedAt window enforcement
----------------------------------------------------------------------

testCoinTransferRejectsExpiredExecuteBeforeV1 : Script ()
testCoinTransferRejectsExpiredExecuteBeforeV1 = do
  admin <- allocateParty "TransferExpiredV1Admin"
  alice <- allocateParty "TransferExpiredV1Alice"
  bob <- allocateParty "TransferExpiredV1Bob"
  factoryCid <- coinFactorySetup admin
  let instrumentId = InstrumentId with admin, id = "COIN-EXPIRED-V1"
  coinCid <- mintCoin factoryCid admin instrumentId alice 0.01
  factoryDisc <- discloseFactory admin factoryCid
  t0 <- getTime
  let transfer = (mkTransferV1 t0 alice bob 0.006 instrumentId [coinCid])
        with executeBefore = t0 `addRelTime` hours (-1)
  res <- trySubmit (actAs alice <> disclose factoryDisc) do
    exerciseCmd (asTransferFactoryV1 factoryCid) TIV1.TransferFactory_Transfer with
      expectedAdmin = admin, transfer, extraArgs = emptyExtraArgs
  expectAbort "executeBefore has passed" res

testCoinTransferRejectsExpiredExecuteBeforeV2 : Script ()
testCoinTransferRejectsExpiredExecuteBeforeV2 = do
