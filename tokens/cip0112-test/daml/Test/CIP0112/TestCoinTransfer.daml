-- | Sub-accounts and provider-delegated accounts are ordinary accounts; only
-- the null-owner account (reserved for mint/burn via 'BurnMintFactory') is
-- rejected here.
testCoinTransferV2RejectsNullOwnerAccount : Script ()
testCoinTransferV2RejectsNullOwnerAccount = do
  admin <- allocateParty "TransferV2NullOwnerAdmin"
  alice <- allocateParty "TransferV2NullOwnerAlice"
  bob <- allocateParty "TransferV2NullOwnerBob"
  factoryCid <- coinFactorySetup admin
  let instrumentIdV2 = HoldingV2.InstrumentId with admin, id = "COIN-V2-NULLOWNER"
  factoryDisc <- discloseFactory admin factoryCid
  t0 <- getTime
  res <- trySubmit (actAs alice <> disclose factoryDisc) do
    exerciseCmd (asTransferFactoryV2 factoryCid) TIV2.TransferFactory_Transfer with
      transfer = TIV2.Transfer with
        sender = HoldingV2.Account with owner = None, provider = None, id = "cip-112/mint"
        receiver = basicAccount bob
        amount = 0.006
        instrumentId = instrumentIdV2
        requestedAt = t0
        executeBefore = t0 `addRelTime` hours 24
        inputHoldingCids = []
        meta = emptyMetadata
      actors = [alice]
      extraArgs = emptyExtraArgs
  expectAbort "null-owner accounts are for mint/burn only" res

----------------------------------------------------------------------
-- v2 TransferInstruction accept/reject/withdraw must self-archive
----------------------------------------------------------------------

-- | Drive a v2 transfer to pending (only the sender is an actor) and return
-- the resulting instruction handle.
mkPendingTransferV2
  : ContractId CoinFactory -> Party -> Party -> Party -> InstrumentId -> Decimal -> [ContractId Holding]
  -> Script (ContractId TIV2.TransferInstruction)
mkPendingTransferV2 factoryCid admin alice bob instrumentId amount inputHoldingCids = do
  let instrumentIdV2 = HoldingV2.InstrumentId with admin, id = instrumentId.id
  factoryDisc <- discloseFactory admin factoryCid
  t0 <- getTime
  res <- submit (actAs alice <> disclose factoryDisc) do
    exerciseCmd (asTransferFactoryV2 factoryCid) TIV2.TransferFactory_Transfer with
      transfer = TIV2.Transfer with
        sender = basicAccount alice
        receiver = basicAccount bob
        amount, instrumentId = instrumentIdV2
        requestedAt = t0
        executeBefore = t0 `addRelTime` hours 24
        inputHoldingCids = map (coerceContractId @Holding @HoldingV2.Holding) inputHoldingCids
        meta = emptyMetadata
      actors = [alice]
      extraArgs = emptyExtraArgs
  case res.output of
    TIV2.TransferInstructionResult_Pending{transferInstructionCid} -> pure transferInstructionCid
    other -> error ("expected Pending, got: " <> show other)

testCoinTransferV2AcceptArchivesInstruction : Script ()
testCoinTransferV2AcceptArchivesInstruction = do
  admin <- allocateParty "TransferV2AcceptArchiveAdmin"
  alice <- allocateParty "TransferV2AcceptArchiveAlice"
  bob <- allocateParty "TransferV2AcceptArchiveBob"
  factoryCid <- coinFactorySetup admin
  let instrumentId = InstrumentId with admin, id = "COIN-V2-ACCEPT-ARCHIVE"
  coinCid <- mintCoin factoryCid admin instrumentId alice 0.01
  instrCid <- mkPendingTransferV2 factoryCid admin alice bob instrumentId 0.006 [coinCid]
  acceptRes <- submit bob do
    exerciseCmd instrCid TIV2.TransferInstruction_Accept with actors = [bob], extraArgs = emptyExtraArgs
  case acceptRes.output of
    TIV2.TransferInstructionResult_Completed{receiverHoldingCids = [rcid]} -> do
      Some r <- queryContractId admin (coerceContractId @HoldingV2.Holding @Coin rcid)
      r.owner === bob
    other -> abort ("expected Completed, got: " <> show other)
  archived <- queryContractId admin (coerceContractId @TIV2.TransferInstruction @CoinTransferInstruction instrCid)
  archived === None
  -- The instruction is gone -- a second accept must fail outright.
  submitMustFail bob do
    exerciseCmd instrCid TIV2.TransferInstruction_Accept with actors = [bob], extraArgs = emptyExtraArgs

----------------------------------------------------------------------
-- v1-nesting compatibility: v2 Accept/Reject/Withdraw nest the corresponding
-- v1 choice where possible, so v1 transaction parsers still see a familiar
-- v1 exercise node. Accept's nesting depends on the receiver account's
-- authority shape; Reject/Withdraw nest unconditionally.
----------------------------------------------------------------------

-- | Basic receiver account: v2 accept nests v1's own consuming Accept, and
-- the instruction is archived by that nested choice.
testCoinTransferV2AcceptNestsV1ForBasicReceiver : Script ()
testCoinTransferV2AcceptNestsV1ForBasicReceiver = do
  admin <- allocateParty "TransferV2AcceptNestBasicAdmin"
  alice <- allocateParty "TransferV2AcceptNestBasicAlice"
  bob <- allocateParty "TransferV2AcceptNestBasicBob"
  factoryCid <- coinFactorySetup admin
  let instrumentId = InstrumentId with admin, id = "COIN-V2-ACCEPT-NEST-BASIC"
  coinCid <- mintCoin factoryCid admin instrumentId alice 0.01
  instrCid <- mkPendingTransferV2 factoryCid admin alice bob instrumentId 0.006 [coinCid]
  (acceptRes, tree) <- submitResultAndTree bob do
    exerciseCmd instrCid TIV2.TransferInstruction_Accept with actors = [bob], extraArgs = emptyExtraArgs
  case acceptRes.output of
    TIV2.TransferInstructionResult_Completed{receiverHoldingCids = [rcid]} -> do
      Some r <- queryContractId admin (coerceContractId @HoldingV2.Holding @Coin rcid)
      r.owner === bob
      r.amount === 0.006
    other -> abort ("expected Completed, got: " <> show other)
  archived <- queryContractId admin (coerceContractId @TIV2.TransferInstruction @CoinTransferInstruction instrCid)
  archived === None
  case tree.rootEvents of
    [ExercisedEvent outer] -> do
      outer.choice === "TransferInstruction_Accept"
      case exercisesOf @TIV1.TransferInstruction "TransferInstruction_Accept" outer.childEvents of
        [_] -> pure ()
        other -> abort ("expected exactly one nested v1 Accept exercise, got: " <> show other)
    other -> abort ("expected exactly one root event, got: " <> show other)

-- | Sub-account receiver: same authority shape as a basic account, so
-- nesting applies here too and the sub-account id survives through.
testCoinTransferV2AcceptNestsV1ForSubAccountReceiver : Script ()
testCoinTransferV2AcceptNestsV1ForSubAccountReceiver = do
  admin <- allocateParty "TransferV2AcceptNestSubAdmin"
  alice <- allocateParty "TransferV2AcceptNestSubAlice"
  bob <- allocateParty "TransferV2AcceptNestSubBob"
  factoryCid <- coinFactorySetup admin
  let instrumentId = InstrumentId with admin, id = "COIN-V2-ACCEPT-NEST-SUB"
      instrumentIdV2 = HoldingV2.InstrumentId with admin, id = instrumentId.id
      receiverAcct = subAccount bob "sub-recv-1"
  coinCid <- mintCoin factoryCid admin instrumentId alice 0.01
  factoryDisc <- discloseFactory admin factoryCid
  t0 <- getTime
  res <- submit (actAs alice <> disclose factoryDisc) do
    exerciseCmd (asTransferFactoryV2 factoryCid) TIV2.TransferFactory_Transfer with
      transfer = TIV2.Transfer with
        sender = basicAccount alice
        receiver = receiverAcct
        amount = 0.006
        instrumentId = instrumentIdV2
        requestedAt = t0
        executeBefore = t0 `addRelTime` hours 24
        inputHoldingCids = [coerceContractId @Holding @HoldingV2.Holding coinCid]
        meta = emptyMetadata
      actors = [alice]
      extraArgs = emptyExtraArgs
  let TIV2.TransferInstructionResult_Pending{transferInstructionCid} = res.output
      instrCid = coerceContractId @TIV2.TransferInstruction @CoinTransferInstruction transferInstructionCid

  (acceptRes, tree) <- submitResultAndTree bob do
    exerciseCmd transferInstructionCid TIV2.TransferInstruction_Accept with actors = [bob], extraArgs = emptyExtraArgs
  case acceptRes.output of
    TIV2.TransferInstructionResult_Completed{receiverHoldingCids = [rcid]} -> do
      Some hv2 <- queryInterfaceContractId admin rcid
      hv2.account === receiverAcct
      hv2.amount === 0.006
    other -> abort ("expected Completed, got: " <> show other)
  archived <- queryContractId admin instrCid
  archived === None
  case tree.rootEvents of
    [ExercisedEvent outer] -> do
      outer.choice === "TransferInstruction_Accept"
      case exercisesOf @TIV1.TransferInstruction "TransferInstruction_Accept" outer.childEvents of
        [_] -> pure ()
        other -> abort ("expected exactly one nested v1 Accept exercise, got: " <> show other)
    other -> abort ("expected exactly one root event, got: " <> show other)

testCoinTransferV2RejectArchivesInstruction : Script ()
testCoinTransferV2RejectArchivesInstruction = do
