-- | Transfer-side templates and the shared value-movement core for
-- 'Token.CIP0056.CoinFactory's @TransferFactory@ v1.
module Token.CIP0056.CoinTransfer where

import DA.Foldable (forA_)
import DA.TextMap qualified as TextMap

import Splice.Api.Token.HoldingV1 (Holding, InstrumentId)
import Splice.Api.Token.MetadataV1 (AnyValue (..), ExtraArgs (..), emptyMetadata)
import Splice.Api.Token.TransferInstructionV1 qualified as TIV1
import Token.CIP0056.Coin

-- | Context key for passing a receiver's standing 'TransferPreapproval' cid
-- to 'transferFactory_transferImpl' (the interface's choice args are fixed,
-- so there's no dedicated field). Absent/undecodable falls back to the
-- pending path -- fail-safe against mis-credited transfers.
transferPreapprovalContextKey : Text
transferPreapprovalContextKey = "token-cip0056.transferPreapprovalCid"

lookupTransferPreapprovalCid : ExtraArgs -> Optional (ContractId TransferPreapproval)
lookupTransferPreapprovalCid extraArgs =
  case TextMap.lookup transferPreapprovalContextKey extraArgs.context.values of
    Some (AV_ContractId cid) -> Some (coerceContractId cid)
    _ -> None

-- | A recipient's standing, self-signed consent to receive transfers of one
-- instrument.
template TransferPreapproval
  with
    owner        : Party
    instrumentId : InstrumentId
  where
    signatory owner
    observer instrumentId.admin

    -- Standalone this is an admin-only unbacked mint (acceptable since admin
    -- is already mint authority); conserves value only when driven from
    -- 'transferCore', which debits the sender in the same transaction.
    nonconsuming choice TransferPreapproval_Receive : ContractId Holding
      with
        receiver             : Party
        amount               : Decimal
        expectedInstrumentId : InstrumentId
      controller instrumentId.admin
      do
        assertMsg "cip0056: preapproval owner is not this transfer's receiver" (receiver == owner)
        assertMsg "cip0056: preapproval instrument does not match the requested instrumentId"
          (expectedInstrumentId == instrumentId)
        toInterfaceContractId @Holding <$> createCoin instrumentId owner amount

-- | Pending state of an in-flight transfer with no standing preapproval:
-- funds are already debited from the sender by the time this is created, so
-- it holds the value directly rather than a separate locked holding.
template CoinTransferInstruction
  with
    instrumentId  : InstrumentId
    sender        : Party
    receiver      : Party
    amount        : Decimal
    requestedAt   : Time
    executeBefore : Time
  where
    signatory instrumentId.admin :: sender :: []
    observer receiver

    interface instance TIV1.TransferInstruction for CoinTransferInstruction where
      view = TIV1.TransferInstructionView with
        originalInstructionCid = None
        transfer = TIV1.Transfer with
          sender, receiver
          amount, instrumentId, requestedAt, executeBefore
          inputHoldingCids = []
          meta = emptyMetadata
        status = TIV1.TransferPendingReceiverAcceptance
        meta = emptyMetadata

      transferInstruction_acceptImpl _self _arg = do
        now <- getTime
        assertMsg "cip0056: transfer.executeBefore has passed; accept is no longer allowed -- reject or withdraw"
          (now < executeBefore)
        rcid <- toInterfaceContractId @Holding <$> createCoin instrumentId receiver amount
        pure TIV1.TransferInstructionResult with
          output = TIV1.TransferInstructionResult_Completed with receiverHoldingCids = [rcid]
          senderChangeCids = []
          meta = emptyMetadata

      transferInstruction_rejectImpl _self _arg = returnToSenderV1 instrumentId sender amount
      transferInstruction_withdrawImpl _self _arg = returnToSenderV1 instrumentId sender amount
      transferInstruction_updateImpl _self _arg =
        abort "cip0056: CoinTransferInstruction does not support registry-internal Update steps"

-- | TransferFactory_Transfer must fail if @executeBefore@ is in the past
-- or @requestedAt@ is in the future.
assertTransferWindow : Time -> Time -> Update ()
assertTransferWindow requestedAt executeBefore = do
  now <- getTime
  assertMsg "cip0056: transfer.requestedAt must not be in the future" (requestedAt <= now)
  assertMsg "cip0056: transfer.executeBefore has passed" (now < executeBefore)

returnToSenderV1 : InstrumentId -> Party -> Decimal -> Update TIV1.TransferInstructionResult
returnToSenderV1 instrumentId sender amount = do
  cid <- toInterfaceContractId @Holding <$> createCoin instrumentId sender amount
  pure TIV1.TransferInstructionResult with
    output = TIV1.TransferInstructionResult_Failed
    senderChangeCids = [cid]
    meta = emptyMetadata

-- | Shared value-movement core for TransferFactory v1's
-- @transferFactory_transferImpl@: debits sender inputs, mints change,
-- completes synchronously (self-transfer / receiver authority present /
-- standing preapproval) or returns 'CorePendingNeeded' for the caller to
-- wrap in an 'CoinTransferInstruction'.
data CoreTransferOutcome
  = CoreCompleted with receiverCid : ContractId Holding, senderChangeCids : [ContractId Holding]
  | CorePendingNeeded with senderChangeCids : [ContractId Holding]

-- | Single-instrument debit: validates ownership + instrument per input,
-- checks coverage, archives inputs, mints change back. Conservation-critical
-- -- inputs are pinned to the 'Coin' template, since a caller-authored
-- interface view alone cannot be trusted.
debitInputs
  : Text                  -- ^ error noun: "transfer" / "allocation"
  -> InstrumentId
  -> Party                -- ^ debited party (change goes back to them)
  -> Decimal              -- ^ amount to debit
  -> [ContractId Holding]
  -> Update [ContractId Holding]  -- ^ change cids ([] or singleton)
debitInputs noun instrumentId sender amount inputHoldingCids = do
  -- Hoisted: Daml is strict, so building these inside the loop costs even on the happy path.
  let notMine = "cip0056: " <> noun <> " input not owned by sender"
      notForeign = "cip0056: " <> noun <> " input is not a Coin issued by this registry"
      wrongInstrument = "cip0056: " <> noun <> " input instrument mismatch"
  coins <- forA inputHoldingCids \cid -> do
    r <- fetchFromInterface @Coin cid
    case r of
      None -> abort notForeign
      Some (_, coin) -> do
        assertMsg notMine (coin.owner == sender)
        assertMsg wrongInstrument (coin.instrumentId == instrumentId)
        pure coin
  let total = sum (map (.amount) coins)
  assertMsg ("cip0056: input holdings do not cover the " <> noun <> " amount") (total >= amount)
  forA_ inputHoldingCids archive
  let change = total - amount
  if change > 0.0
    then do
      cid <- toInterfaceContractId @Holding <$> createCoin instrumentId sender change
      pure [cid]
    else pure []

transferCore
  : Party -> Bool -> Party -> Party -> Decimal -> InstrumentId -> [ContractId Holding] -> ExtraArgs
  -> Update CoreTransferOutcome
transferCore admin receiverAuthorityPresent sender receiver amount instrumentId inputHoldingCids extraArgs = do
  assertMsg "cip0056: CoinFactory only serves instruments administered by admin"
    (instrumentId.admin == admin)
  assertMsg "cip0056: transfer amount must be positive" (amount > 0.0)
  senderChangeCids <- debitInputs "transfer" instrumentId sender amount inputHoldingCids
  if receiverAuthorityPresent
    then do
      rcid <- toInterfaceContractId @Holding <$> createCoin instrumentId receiver amount
      pure CoreCompleted with receiverCid = rcid, senderChangeCids
    else case lookupTransferPreapprovalCid extraArgs of
      Some preCid -> do
        rcid <- exercise preCid TransferPreapproval_Receive with
          receiver = receiver, amount, expectedInstrumentId = instrumentId
        pure CoreCompleted with receiverCid = rcid, senderChangeCids
      None -> pure CorePendingNeeded with senderChangeCids
