testCoinTransferWithdrawBySenderReturnsFundsV1 = do
  admin <- allocateParty "TransferWithdrawV1Admin"
  alice <- allocateParty "TransferWithdrawV1Alice"
  bob <- allocateParty "TransferWithdrawV1Bob"
