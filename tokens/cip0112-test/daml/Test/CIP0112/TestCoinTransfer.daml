      Some c <- queryContractId admin (coerceContractId @Holding @Coin cid)
      c.owner === alice
    other -> abort ("expected one returned coin, got: " <> show other)

testCoinTransferRejectsMismatchedPreapprovalV1 : Script ()
testCoinTransferRejectsMismatchedPreapprovalV1 = do
  admin <- allocateParty "TransferMismatchV1Admin"
  alice <- allocateParty "TransferMismatchV1Alice"
  bob <- allocateParty "TransferMismatchV1Bob"
  carol <- allocateParty "TransferMismatchV1Carol"
  factoryCid <- coinFactorySetup admin
  let instrumentId = InstrumentId with admin, id = "COIN-MISMATCH-PRE-V1"
  coinCid <- mintCoin factoryCid admin instrumentId alice 0.01
  -- carol's preapproval, but alice claims to send to bob.
  carolPreCid <- submit carol do createCmd TransferPreapproval with account = basicAccount carol, instrumentId
  factoryDisc <- discloseFactory admin factoryCid
  carolPreDisc <- fromSome <$> queryDisclosure carol carolPreCid
  t0 <- getTime
  res <- trySubmit (actAs alice <> disclose factoryDisc <> disclose carolPreDisc) do
    exerciseCmd (asTransferFactoryV1 factoryCid) TIV1.TransferFactory_Transfer with
      expectedAdmin = admin
      transfer = mkTransferV1 t0 alice bob 0.01 instrumentId [coinCid]
      extraArgs = extraArgsWithPreapproval carolPreCid
  -- receiver != owner mismatch aborts inside TransferPreapproval_Receive.
  expectAbort "preapproval owner is not this transfer's receiver" res

-- | With empty inputs and a negative amount, the positivity guard must abort
-- before the coverage/change arithmetic can mint a change coin from nothing.
testCoinTransferRejectsNegativeAmountV1 : Script ()
testCoinTransferRejectsNegativeAmountV1 = do
  admin <- allocateParty "TransferNegV1Admin"
  alice <- allocateParty "TransferNegV1Alice"
  bob <- allocateParty "TransferNegV1Bob"
  factoryCid <- coinFactorySetup admin
  let instrumentId = InstrumentId with admin, id = "COIN-NEG-V1"
  factoryDisc <- discloseFactory admin factoryCid
  t0 <- getTime
  res <- trySubmit (actAs alice <> disclose factoryDisc) do
    exerciseCmd (asTransferFactoryV1 factoryCid) TIV1.TransferFactory_Transfer with
      expectedAdmin = admin
      transfer = mkTransferV1 t0 alice bob (-0.01) instrumentId []
      extraArgs = emptyExtraArgs
  expectAbort "transfer amount must be positive" res
  coins <- query @Coin admin
  coins === []

-- | v2 counterpart: same negative-amount exploit check, with both actors
-- present so the transfer would otherwise complete synchronously.
testCoinTransferRejectsNegativeAmountV2 : Script ()
testCoinTransferRejectsNegativeAmountV2 = do
  admin <- allocateParty "TransferNegV2Admin"
  alice <- allocateParty "TransferNegV2Alice"
  bob <- allocateParty "TransferNegV2Bob"
  factoryCid <- coinFactorySetup admin
  let instrumentIdV2 = HoldingV2.InstrumentId with admin, id = "COIN-NEG-V2"
  factoryDisc <- discloseFactory admin factoryCid
  t0 <- getTime
  res <- trySubmit (actAs alice <> actAs bob <> disclose factoryDisc) do
    exerciseCmd (asTransferFactoryV2 factoryCid) TIV2.TransferFactory_Transfer with
      transfer = TIV2.Transfer with
        sender = basicAccount alice
        receiver = basicAccount bob
        amount = -0.01
        instrumentId = instrumentIdV2
        requestedAt = t0
        executeBefore = t0 `addRelTime` hours 24
        inputHoldingCids = []
        meta = emptyMetadata
      actors = [alice, bob]
      extraArgs = emptyExtraArgs
  expectAbort "transfer amount must be positive" res
  coins <- query @Coin admin
  coins === []

----------------------------------------------------------------------
-- Transfer v2 -- actors-based synchronous completion + basic-account rejection
----------------------------------------------------------------------

testCoinTransferV2CompletesWhenBothActorsPresent : Script ()
testCoinTransferV2CompletesWhenBothActorsPresent = do
  admin <- allocateParty "TransferV2BothAdmin"
  alice <- allocateParty "TransferV2BothAlice"
  bob <- allocateParty "TransferV2BothBob"
  factoryCid <- coinFactorySetup admin
  let instrumentId = InstrumentId with admin, id = "COIN-V2-BOTH"
      instrumentIdV2 = HoldingV2.InstrumentId with admin, id = instrumentId.id
  coinCid <- mintCoin factoryCid admin instrumentId alice 0.01
  factoryDisc <- discloseFactory admin factoryCid
  t0 <- getTime
  res <- submit (actAs alice <> actAs bob <> disclose factoryDisc) do
    exerciseCmd (asTransferFactoryV2 factoryCid) TIV2.TransferFactory_Transfer with
      transfer = TIV2.Transfer with
        sender = basicAccount alice
        receiver = basicAccount bob
        amount = 0.006
        instrumentId = instrumentIdV2
        requestedAt = t0
        executeBefore = t0 `addRelTime` hours 24
        inputHoldingCids = [coerceContractId @Holding @HoldingV2.Holding coinCid]
        meta = emptyMetadata
      actors = [alice, bob]
      extraArgs = emptyExtraArgs
  case res.output of
    TIV2.TransferInstructionResult_Completed{receiverHoldingCids = [rcid]} -> do
      Some r <- queryContractId admin (coerceContractId @HoldingV2.Holding @Coin rcid)
      r.owner === bob
      r.amount === 0.006
    other -> abort ("expected Completed, got: " <> show other)

