-- | Daml Script tests for the 'Token.CIP0112.CoinFactory' 'AllocationFactory'
-- v2 and 'SettlementFactory' additions, and 'CoinAllocationV2': multi-leg
-- net settlement, iterated/committed allocations.
--
-- The critical property these tests exist to prove: a v2 allocation only
-- ever authorizes ONE party's side of a leg -- a real transfer between two
-- parties always needs TWO allocations (one per side), and value only
-- genuinely moves when 'SettlementFactory_SettleBatch' settles both together
-- in the same transaction. 'testSettleBatchHappyPathTwoAllocations' is the
-- direct proof of that.
module Test.CIP0112.TestCoinAllocationV2 where

import Daml.Script
import DA.Assert ((===))
import DA.Optional (fromSome)
import DA.Time (hours, addRelTime)
import DA.TextMap qualified as TextMap

import Splice.Api.Token.HoldingV1 (InstrumentId(..))
import Splice.Api.Token.HoldingV2 qualified as HoldingV2
import Splice.Api.Token.MetadataV1 (emptyMetadata)
import Splice.Api.Token.AllocationV2 qualified as AV2
import Splice.Api.Token.AllocationInstructionV2 qualified as AIV2
import Token.CIP0112.Coin
import Token.CIP0112.CoinAllocationV2
import Token.CIP0112.CoinFactory
import Test.CIP0112.TestUtils (coinFactorySetup, expectAbort, emptyExtraArgs, mintCoin)

asAllocationFactoryV2 : ContractId CoinFactory -> ContractId AIV2.AllocationFactory
asAllocationFactoryV2 = toInterfaceContractId @AIV2.AllocationFactory

asSettlementFactory : ContractId CoinFactory -> ContractId AV2.SettlementFactory
asSettlementFactory = toInterfaceContractId @AV2.SettlementFactory

discloseFactory : Party -> ContractId CoinFactory -> Script Disclosure
discloseFactory admin factoryCid = fromSome <$> queryDisclosure admin factoryCid

basicAccount : Party -> HoldingV2.Account
basicAccount p = HoldingV2.Account with owner = Some p, provider = None, id = ""

-- | A provider-delegated account: @owner@ is the account holder, @provider@
-- co-signs every movement (see 'Token.CIP0112.Coin' module header).
providerAccount : Party -> Party -> HoldingV2.Account
providerAccount owner provider = HoldingV2.Account with owner = Some owner, provider = Some provider, id = ""

mkSettlement : [Party] -> Text -> AV2.SettlementInfo
mkSettlement executors sid = AV2.SettlementInfo with executors, id = sid, cid = None, meta = emptyMetadata

mkLeg : Text -> AV2.TransferSide -> Party -> Decimal -> Text -> AV2.TransferLegSide
mkLeg transferLegId side otherside amount instrumentId =
  AV2.TransferLegSide with transferLegId, side, otherside = basicAccount otherside, amount, instrumentId, meta = emptyMetadata

mkSpec : Party -> Party -> [AV2.TransferLegSide] -> AV2.AllocationSpecification
mkSpec admin authorizer transferLegSides =
  AV2.AllocationSpecification with
    admin, authorizer = basicAccount authorizer, transferLegSides
    settlementDeadline = None, nextIterationFunding = None, committed = False, meta = emptyMetadata

mintCoinV2 : ContractId CoinFactory -> Party -> InstrumentId -> Party -> Decimal -> Script (ContractId HoldingV2.Holding)
mintCoinV2 factoryCid admin instrumentId owner amount =
  coerceContractId <$> mintCoin factoryCid admin instrumentId owner amount

tryAllocate
  : ContractId CoinFactory -> Party -> Party -> AV2.SettlementInfo -> AV2.AllocationSpecification -> [ContractId HoldingV2.Holding]
  -> Script (Either SubmitError AIV2.AllocationInstructionResult)
tryAllocate factoryCid admin authorizerOwner settlement spec inputHoldingCids = do
  factoryDisc <- discloseFactory admin factoryCid
  t0 <- getTime
  trySubmit (actAs authorizerOwner <> disclose factoryDisc) do
    exerciseCmd (asAllocationFactoryV2 factoryCid) AIV2.AllocationFactory_Allocate with
      settlement, allocation = spec, requestedAt = t0, inputHoldingCids
      extraArgs = emptyExtraArgs, actors = [authorizerOwner]

allocate
  : ContractId CoinFactory -> Party -> Party -> AV2.SettlementInfo -> AV2.AllocationSpecification -> [ContractId HoldingV2.Holding]
  -> Script AIV2.AllocationInstructionResult
allocate factoryCid admin authorizerOwner settlement spec inputHoldingCids = do
  res <- tryAllocate factoryCid admin authorizerOwner settlement spec inputHoldingCids
  case res of
    Right ok -> pure ok
    Left err -> abort ("expected AllocationFactory_Allocate to succeed, got: " <> show err)

theAllocationCidV2 : AIV2.AllocationInstructionResult -> ContractId AV2.Allocation
theAllocationCidV2 res = case res.output of
  AIV2.AllocationInstructionResult_Completed{allocationCid} -> allocationCid
  other -> error ("expected AllocationInstructionResult_Completed, got: " <> show other)

asConcrete : ContractId AV2.Allocation -> ContractId CoinAllocationV2
asConcrete = coerceContractId

trySettleBatch
  : ContractId CoinFactory -> Party -> AV2.SettlementInfo -> [AV2.TransferLeg] -> [AV2.FinalizedAllocation] -> [Party]
  -> Script (Either SubmitError AV2.SettlementFactory_SettleBatchResult)
trySettleBatch factoryCid admin settlement transferLegs allocations actors = do
  factoryDisc <- discloseFactory admin factoryCid
  trySubmit (foldl (<>) (disclose factoryDisc) (map actAs actors)) do
    exerciseCmd (asSettlementFactory factoryCid) AV2.SettlementFactory_SettleBatch with
      settlement, transferLegs, allocations, actors, extraArgs = emptyExtraArgs

settleBatch
  : ContractId CoinFactory -> Party -> AV2.SettlementInfo -> [AV2.TransferLeg] -> [AV2.FinalizedAllocation] -> [Party]
  -> Script AV2.SettlementFactory_SettleBatchResult
settleBatch factoryCid admin settlement transferLegs allocations actors = do
  res <- trySettleBatch factoryCid admin settlement transferLegs allocations actors
  case res of
    Right ok -> pure ok
    Left err -> abort ("expected SettlementFactory_SettleBatch to succeed, got: " <> show err)

finalized : ContractId AV2.Allocation -> AV2.FinalizedAllocation
finalized cid = AV2.FinalizedAllocation with allocationCid = cid, extraTransferLegSides = [], nextIterationFunding = None

----------------------------------------------------------------------
-- Allocate
----------------------------------------------------------------------

testAllocateV2SingleLeg : Script ()
testAllocateV2SingleLeg = do
  admin <- allocateParty "AllocV2SingleAdmin"
  alice <- allocateParty "AllocV2SingleAlice"
  bob <- allocateParty "AllocV2SingleBob"
  carol <- allocateParty "AllocV2SingleCarolExecutor"
  factoryCid <- coinFactorySetup admin
  let instrumentId = InstrumentId with admin, id = "COIN-ALLOCV2-SINGLE"
  coinCid <- mintCoinV2 factoryCid admin instrumentId alice 0.006
  let settlement = mkSettlement [carol] "settlement-single"
      spec = mkSpec admin alice [mkLeg "leg-0" AV2.SenderSide bob 0.006 "COIN-ALLOCV2-SINGLE"]
  res <- allocate factoryCid admin alice settlement spec [coinCid]
  let allocCid = asConcrete (theAllocationCidV2 res)
  Some alloc <- queryContractId admin allocCid
  alloc.numIterations === 0
  alloc.originalAllocationCid === None
  TextMap.lookup "COIN-ALLOCV2-SINGLE" alloc.lockedAmounts === Some 0.006

testAllocateV2MultiLegMultiInstrument : Script ()
testAllocateV2MultiLegMultiInstrument = do
  admin <- allocateParty "AllocV2MultiAdmin"
  alice <- allocateParty "AllocV2MultiAlice"
  bob <- allocateParty "AllocV2MultiBob"
  carol <- allocateParty "AllocV2MultiCarol"
  dave <- allocateParty "AllocV2MultiDaveExecutor"
  factoryCid <- coinFactorySetup admin
  let instA = InstrumentId with admin, id = "COIN-ALLOCV2-MULTI-A"
      instB = InstrumentId with admin, id = "COIN-ALLOCV2-MULTI-B"
  coinA <- mintCoinV2 factoryCid admin instA alice 0.01
  coinB <- mintCoinV2 factoryCid admin instB alice 0.02
  let settlement = mkSettlement [dave] "settlement-multi"
      spec = mkSpec admin alice
        [ mkLeg "leg-a" AV2.SenderSide bob 0.01 "COIN-ALLOCV2-MULTI-A"
        , mkLeg "leg-b" AV2.SenderSide carol 0.02 "COIN-ALLOCV2-MULTI-B"
        ]
  res <- allocate factoryCid admin alice settlement spec [coinA, coinB]
  let allocCid = asConcrete (theAllocationCidV2 res)
  Some alloc <- queryContractId admin allocCid
  TextMap.lookup "COIN-ALLOCV2-MULTI-A" alloc.lockedAmounts === Some 0.01
  TextMap.lookup "COIN-ALLOCV2-MULTI-B" alloc.lockedAmounts === Some 0.02

testAllocateV2ReturnsStrayInstrumentChangeUntouched : Script ()
testAllocateV2ReturnsStrayInstrumentChangeUntouched = do
  admin <- allocateParty "AllocV2StrayAdmin"
  alice <- allocateParty "AllocV2StrayAlice"
  bob <- allocateParty "AllocV2StrayBob"
  carol <- allocateParty "AllocV2StrayCarolExecutor"
  factoryCid <- coinFactorySetup admin
  let leg = InstrumentId with admin, id = "COIN-ALLOCV2-STRAY-LEG"
      stray = InstrumentId with admin, id = "COIN-ALLOCV2-STRAY-EXTRA"
  legCoin <- mintCoinV2 factoryCid admin leg alice 0.006
  strayCoin <- mintCoinV2 factoryCid admin stray alice 0.05
  let settlement = mkSettlement [carol] "settlement-stray"
      spec = mkSpec admin alice [mkLeg "leg-0" AV2.SenderSide bob 0.006 "COIN-ALLOCV2-STRAY-LEG"]
  res <- allocate factoryCid admin alice settlement spec [legCoin, strayCoin]
  case TextMap.lookup "COIN-ALLOCV2-STRAY-EXTRA" res.authorizerChangeCids of
    Some [cid] -> do
      Some c <- queryContractId admin (coerceContractId @HoldingV2.Holding @Coin cid)
      c.amount === 0.05
    other -> abort ("expected stray instrument fully returned as change, got: " <> show other)

testAllocateV2RejectsUnderfundedRequiredTotal : Script ()
testAllocateV2RejectsUnderfundedRequiredTotal = do
  admin <- allocateParty "AllocV2UnderfundedAdmin"
  alice <- allocateParty "AllocV2UnderfundedAlice"
  bob <- allocateParty "AllocV2UnderfundedBob"
  carol <- allocateParty "AllocV2UnderfundedCarolExecutor"
  factoryCid <- coinFactorySetup admin
  let instrumentId = InstrumentId with admin, id = "COIN-ALLOCV2-UNDERFUNDED"
  coinCid <- mintCoinV2 factoryCid admin instrumentId alice 0.006
  let settlement = mkSettlement [carol] "settlement-underfunded"
      spec = (mkSpec admin alice [mkLeg "leg-0" AV2.SenderSide bob 0.006 "COIN-ALLOCV2-UNDERFUNDED"])
        with nextIterationFunding = Some (TextMap.fromList [("COIN-ALLOCV2-UNDERFUNDED", 0.01)])
  res <- tryAllocate factoryCid admin alice settlement spec [coinCid]
  expectAbort "do not cover the allocation's required funding" res

-- | 'nextIterationFunding' feeds @requiredTotals@/@change@ unchecked; a
-- NEGATIVE reserve entry would let @change = have - need@ mint a positive
-- coin larger than what was actually put in.
testAllocateV2RejectsNegativeNextIterationFunding : Script ()
testAllocateV2RejectsNegativeNextIterationFunding = do
  admin <- allocateParty "AllocV2NegReserveAdmin"
  alice <- allocateParty "AllocV2NegReserveAlice"
  bob <- allocateParty "AllocV2NegReserveBob"
  carol <- allocateParty "AllocV2NegReserveCarolExecutor"
  factoryCid <- coinFactorySetup admin
  let settlement = mkSettlement [carol] "settlement-negreserve"
      spec = (mkSpec admin alice [mkLeg "leg-0" AV2.SenderSide bob 0.006 "COIN-ALLOCV2-NEGRESERVE"])
        with nextIterationFunding = Some (TextMap.fromList [("COIN-ALLOCV2-NEGRESERVE", -0.01)])
  res <- tryAllocate factoryCid admin alice settlement spec []
  expectAbort "nextIterationFunding amounts must be positive" res

----------------------------------------------------------------------
-- SettlementFactory_SettleBatch -- the critical value-movement proof
----------------------------------------------------------------------

testSettleBatchHappyPathTwoAllocations : Script ()
testSettleBatchHappyPathTwoAllocations = do
  admin <- allocateParty "SettleHappyAdmin"
  alice <- allocateParty "SettleHappyAlice"
  bob <- allocateParty "SettleHappyBob"
  carol <- allocateParty "SettleHappyCarolExecutor"
  factoryCid <- coinFactorySetup admin
  let instrumentId = InstrumentId with admin, id = "COIN-SETTLE-HAPPY"
  coinCid <- mintCoinV2 factoryCid admin instrumentId alice 0.006
  let settlement = mkSettlement [carol] "settlement-happy"
      aliceSpec = mkSpec admin alice [mkLeg "leg-0" AV2.SenderSide bob 0.006 "COIN-SETTLE-HAPPY"]
      bobSpec = mkSpec admin bob [mkLeg "leg-0" AV2.ReceiverSide alice 0.006 "COIN-SETTLE-HAPPY"]
  aliceRes <- allocate factoryCid admin alice settlement aliceSpec [coinCid]
  bobRes <- allocate factoryCid admin bob settlement bobSpec []
  let aliceAllocCid = theAllocationCidV2 aliceRes
      bobAllocCid = theAllocationCidV2 bobRes
      transferLegs = [AV2.TransferLeg with
        transferLegId = "leg-0", sender = basicAccount alice, receiver = basicAccount bob
        amount = 0.006, instrumentId = "COIN-SETTLE-HAPPY", meta = emptyMetadata]
  settleRes <- settleBatch factoryCid admin settlement transferLegs
    [finalized aliceAllocCid, finalized bobAllocCid] [carol]
  case settleRes.allocationSettleResults of
    [r1, r2] -> do
      let outputs = [r1.output, r2.output]
      assertMsg "expected both allocations to settle fully with no next iteration"
        (all (\o -> o == AV2.AllocationResult_Settled with nextIterationAllocationCid = None) outputs)
    other -> abort ("expected two settle results, got: " <> show other)
  bobHoldings <- query @Coin admin
  case [c | (_, c) <- bobHoldings, c.owner == bob] of
    [c] -> c.amount === 0.006
    other -> abort ("expected bob to receive exactly one coin, got: " <> show other)
  archivedAlice <- queryContractId admin (asConcrete aliceAllocCid)
  archivedBob <- queryContractId admin (asConcrete bobAllocCid)
  archivedAlice === None
  archivedBob === None

testSettleBatchRejectsMissingSenderSideAuthorization : Script ()
testSettleBatchRejectsMissingSenderSideAuthorization = do
  admin <- allocateParty "SettleMissingSenderAdmin"
  alice <- allocateParty "SettleMissingSenderAlice"
  bob <- allocateParty "SettleMissingSenderBob"
  carol <- allocateParty "SettleMissingSenderCarolExecutor"
  factoryCid <- coinFactorySetup admin
  let instrumentId = InstrumentId with admin, id = "COIN-SETTLE-NOSENDER"
      settlement = mkSettlement [carol] "settlement-nosender"
      bobSpec = mkSpec admin bob [mkLeg "leg-0" AV2.ReceiverSide alice 0.006 "COIN-SETTLE-NOSENDER"]
  bobRes <- allocate factoryCid admin bob settlement bobSpec []
  let transferLegs = [AV2.TransferLeg with
        transferLegId = "leg-0", sender = basicAccount alice, receiver = basicAccount bob
        amount = 0.006, instrumentId = "COIN-SETTLE-NOSENDER", meta = emptyMetadata]
  res <- trySettleBatch factoryCid admin settlement transferLegs [finalized (theAllocationCidV2 bobRes)] [carol]
  expectAbort "no matching SenderSide allocation" res

