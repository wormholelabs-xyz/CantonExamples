      spec = (mkSpec admin alice [mkLeg "leg-0" AV2.SenderSide bob 0.006 "COIN-WITHDRAWCOMMITTEDAFTER"])
        with committed = True, settlementDeadline = Some (t0 `addRelTime` hours (-1))
  res <- allocate factoryCid admin alice settlement spec [coinCid]
  let allocCid = theAllocationCidV2 res
  withdrawRes <- submit alice do
    exerciseCmd allocCid AV2.Allocation_Withdraw with actors = [alice], extraArgs = emptyExtraArgs
  withdrawRes.output === AV2.AllocationResult_Withdrawn

----------------------------------------------------------------------
-- Iterated settlement
----------------------------------------------------------------------

testIteratedSettlementCarriesForwardAndReturnsLeftover : Script ()
testIteratedSettlementCarriesForwardAndReturnsLeftover = do
  admin <- allocateParty "IteratedAdmin"
  alice <- allocateParty "IteratedAlice"
  bob <- allocateParty "IteratedBob"
  carol <- allocateParty "IteratedCarolExecutor"
  factoryCid <- coinFactorySetup admin
  let instrumentId = InstrumentId with admin, id = "COIN-ITERATED"
  coinCid <- mintCoinV2 factoryCid admin instrumentId alice 0.03
  let settlement = mkSettlement [carol] "settlement-iterated"
      aliceSpec = (mkSpec admin alice [mkLeg "leg-0" AV2.SenderSide bob 0.01 "COIN-ITERATED"])
        with nextIterationFunding = Some (TextMap.fromList [("COIN-ITERATED", 0.015)])
      bobSpec = mkSpec admin bob [mkLeg "leg-0" AV2.ReceiverSide alice 0.01 "COIN-ITERATED"]
  aliceRes <- allocate factoryCid admin alice settlement aliceSpec [coinCid]
  -- Only the required total (senderTotal 0.01 + reserve 0.015 = 0.025) gets
  -- locked; the 0.005 surplus over that comes back immediately as allocate-time
  -- change, not as settle-time leftover.
  case TextMap.lookup "COIN-ITERATED" aliceRes.authorizerChangeCids of
    Some [cid] -> do
      Some c <- queryContractId admin (coerceContractId @HoldingV2.Holding @Coin cid)
      c.amount === 0.005
    other -> abort ("expected allocate-time change of 0.005, got: " <> show other)
  bobRes <- allocate factoryCid admin bob settlement bobSpec []
  let transferLegs = [AV2.TransferLeg with
        transferLegId = "leg-0", sender = basicAccount alice, receiver = basicAccount bob
        amount = 0.01, instrumentId = "COIN-ITERATED", meta = emptyMetadata]
      aliceFa = AV2.FinalizedAllocation with
        allocationCid = theAllocationCidV2 aliceRes, extraTransferLegSides = []
        nextIterationFunding = Some (TextMap.fromList [("COIN-ITERATED", 0.015)])
      bobFa = finalized (theAllocationCidV2 bobRes)
  round1 <- settleBatch factoryCid admin settlement transferLegs [aliceFa, bobFa] [carol]
  let [aliceResult1, _bobResult1] = round1.allocationSettleResults
  nextAliceCid <- case aliceResult1.output of
    AV2.AllocationResult_Settled{nextIterationAllocationCid = Some cid} -> pure cid
    other -> do
      _ <- abort ("expected alice's round 1 to carry forward, got: " <> show other)
      pure (error "unreachable")
  -- 0.025 locked - 0.01 spent - 0.015 carried = 0 leftover this round.
  TextMap.lookup "COIN-ITERATED" aliceResult1.authorizerHoldingCids === None
  Some nextAlloc <- queryContractId admin (asConcrete nextAliceCid)
  nextAlloc.numIterations === 1
  TextMap.lookup "COIN-ITERATED" nextAlloc.lockedAmounts === Some 0.015

  -- Round 2: settle the carried-forward allocation fully (no further iteration).
  bobRes2 <- allocate factoryCid admin bob settlement bobSpec []
  let round2Fa = finalized nextAliceCid
      round2BobFa = finalized (theAllocationCidV2 bobRes2)
  round2 <- settleBatch factoryCid admin settlement transferLegs [round2Fa, round2BobFa] [carol]
  let [aliceResult2, _bobResult2] = round2.allocationSettleResults
  aliceResult2.output === AV2.AllocationResult_Settled with nextIterationAllocationCid = None
  case TextMap.lookup "COIN-ITERATED" aliceResult2.authorizerHoldingCids of
    Some [cid] -> do
      Some c <- queryContractId admin (coerceContractId @HoldingV2.Holding @Coin cid)
      c.amount === 0.005
    other -> abort ("expected round-2 leftover of 0.005, got: " <> show other)

----------------------------------------------------------------------
-- Defensive checks
----------------------------------------------------------------------

testAllocateV2RejectsMismatchedAdmin : Script ()
testAllocateV2RejectsMismatchedAdmin = do
  admin <- allocateParty "AllocV2MismatchAdmin"
  notAdmin <- allocateParty "AllocV2MismatchNotAdmin"
  alice <- allocateParty "AllocV2MismatchAlice"
  bob <- allocateParty "AllocV2MismatchBob"
  carol <- allocateParty "AllocV2MismatchCarolExecutor"
  factoryCid <- coinFactorySetup admin
  let settlement = mkSettlement [carol] "settlement-mismatch"
      spec = mkSpec notAdmin alice [mkLeg "leg-0" AV2.SenderSide bob 0.006 "COIN-ALLOCV2-MISMATCH"]
  res <- tryAllocate factoryCid admin alice settlement spec []
  expectAbort "admin does not match this factory's admin" res

testAllocateV2RejectsNonAuthorizerActor : Script ()
testAllocateV2RejectsNonAuthorizerActor = do
  admin <- allocateParty "AllocV2NonAuthAdmin"
  alice <- allocateParty "AllocV2NonAuthAlice"
  bob <- allocateParty "AllocV2NonAuthBob"
  carol <- allocateParty "AllocV2NonAuthCarolExecutor"
  factoryCid <- coinFactorySetup admin
  factoryDisc <- discloseFactory admin factoryCid
  let settlement = mkSettlement [carol] "settlement-nonauth"
      spec = mkSpec admin alice [mkLeg "leg-0" AV2.SenderSide bob 0.006 "COIN-ALLOCV2-NONAUTH"]
  t0 <- getTime
  res <- trySubmit (actAs bob <> disclose factoryDisc) do
    exerciseCmd (asAllocationFactoryV2 factoryCid) AIV2.AllocationFactory_Allocate with
      settlement, allocation = spec, requestedAt = t0, inputHoldingCids = []
      extraArgs = emptyExtraArgs, actors = [bob]
  expectAbort "requires the authorizer account's owner and provider authority" res

----------------------------------------------------------------------
-- Footgun guard: naked Allocation_Settle outside SettleBatch
----------------------------------------------------------------------

-- | A direct 'Allocation_Settle' has no automatic counterparty and so no
-- automatic soundness check -- a footgun guard, not a security boundary.
testNakedAllocationSettleIsRejected : Script ()
testNakedAllocationSettleIsRejected = do
  admin <- allocateParty "NakedSettleAdmin"
  alice <- allocateParty "NakedSettleAlice"
  bob <- allocateParty "NakedSettleBob"
  carol <- allocateParty "NakedSettleCarolExecutor"
  factoryCid <- coinFactorySetup admin
  let instrumentId = InstrumentId with admin, id = "COIN-NAKEDSETTLE"
  coinCid <- mintCoinV2 factoryCid admin instrumentId alice 0.006
  let settlement = mkSettlement [carol] "settlement-nakedsettle"
      spec = mkSpec admin alice [mkLeg "leg-0" AV2.SenderSide bob 0.006 "COIN-NAKEDSETTLE"]
  res <- allocate factoryCid admin alice settlement spec [coinCid]
  let allocCid = theAllocationCidV2 res
  naked <- trySubmit (actAs admin <> actAs carol) do
    exerciseCmd allocCid AV2.Allocation_Settle with
      actors = [admin, carol], extraTransferLegSides = [], nextIterationFunding = None
      extraArgs = emptyExtraArgs
  expectAbort "must be driven through SettlementFactory_SettleBatch" naked

----------------------------------------------------------------------
-- Iterated settlement: standing legs recur every round
----------------------------------------------------------------------

-- | A standing leg is not "consumed" after round 1 -- it recurs on the
-- carried-forward allocation in round 2, for both sender and receiver.
testIteratedSettlementRoundTwoCompletes : Script ()
testIteratedSettlementRoundTwoCompletes = do
  admin <- allocateParty "IteratedRound2Admin"
  alice <- allocateParty "IteratedRound2Alice"
  bob <- allocateParty "IteratedRound2Bob"
  carol <- allocateParty "IteratedRound2CarolExecutor"
  factoryCid <- coinFactorySetup admin
  let instrumentId = InstrumentId with admin, id = "COIN-ITERATEDROUND2"
  coinCid <- mintCoinV2 factoryCid admin instrumentId alice 0.02
  let settlement = mkSettlement [carol] "settlement-iteratedround2"
      aliceSpec = (mkSpec admin alice [mkLeg "leg-0" AV2.SenderSide bob 0.01 "COIN-ITERATEDROUND2"])
        with nextIterationFunding = Some (TextMap.fromList [("COIN-ITERATEDROUND2", 0.01)])
      bobSpec = (mkSpec admin bob [mkLeg "leg-0" AV2.ReceiverSide alice 0.01 "COIN-ITERATEDROUND2"])
        with nextIterationFunding = Some TextMap.empty
  aliceRes <- allocate factoryCid admin alice settlement aliceSpec [coinCid]
  -- 0.02 minted, 0.02 required (0.01 round-1 SenderSide + 0.01 reserve) -- no
  -- allocate-time change.
  aliceRes.authorizerChangeCids === TextMap.empty
  bobRes <- allocate factoryCid admin bob settlement bobSpec []
  let transferLegs = [AV2.TransferLeg with
        transferLegId = "leg-0", sender = basicAccount alice, receiver = basicAccount bob
        amount = 0.01, instrumentId = "COIN-ITERATEDROUND2", meta = emptyMetadata]
      aliceFa = AV2.FinalizedAllocation with
        allocationCid = theAllocationCidV2 aliceRes, extraTransferLegSides = []
        nextIterationFunding = Some (TextMap.fromList [("COIN-ITERATEDROUND2", 0.01)])
      bobFa = AV2.FinalizedAllocation with
        allocationCid = theAllocationCidV2 bobRes, extraTransferLegSides = []
        nextIterationFunding = Some TextMap.empty

  round1 <- settleBatch factoryCid admin settlement transferLegs [aliceFa, bobFa] [carol]
  let [aliceResult1, bobResult1] = round1.allocationSettleResults
  nextAliceCid <- case aliceResult1.output of
    AV2.AllocationResult_Settled{nextIterationAllocationCid = Some cid} -> pure cid
    other -> do
      _ <- abort ("expected alice's round 1 to carry forward, got: " <> show other)
      pure (error "unreachable")
  nextBobCid <- case bobResult1.output of
    AV2.AllocationResult_Settled{nextIterationAllocationCid = Some cid} -> pure cid
    other -> do
      _ <- abort ("expected bob's round 1 to carry forward, got: " <> show other)
      pure (error "unreachable")

  case TextMap.lookup "COIN-ITERATEDROUND2" bobResult1.authorizerHoldingCids of
    Some [cid] -> do
      Some c <- queryContractId admin (coerceContractId @HoldingV2.Holding @Coin cid)
      c.owner === bob
      c.amount === 0.01
    other -> abort ("expected bob credited 0.01 in round 1, got: " <> show other)

  Some nextAlice <- queryContractId admin (asConcrete nextAliceCid)
  nextAlice.numIterations === 1
  TextMap.lookup "COIN-ITERATEDROUND2" nextAlice.lockedAmounts === Some 0.01

  -- Round 2: settle the carried-forward pair fully, no further iteration.
  let round2AliceFa = finalized nextAliceCid
      round2BobFa = finalized nextBobCid
  round2 <- settleBatch factoryCid admin settlement transferLegs [round2AliceFa, round2BobFa] [carol]
  let [aliceResult2, bobResult2] = round2.allocationSettleResults
  aliceResult2.output === AV2.AllocationResult_Settled with nextIterationAllocationCid = None
  bobResult2.output === AV2.AllocationResult_Settled with nextIterationAllocationCid = None

  case TextMap.lookup "COIN-ITERATEDROUND2" bobResult2.authorizerHoldingCids of
    Some [cid] -> do
      Some c <- queryContractId admin (coerceContractId @HoldingV2.Holding @Coin cid)
      c.owner === bob
      c.amount === 0.01
    other -> abort ("expected bob credited a second 0.01 in round 2, got: " <> show other)

  -- Bob received two separate 0.01 coins across the two rounds -- total 0.02,
  -- no stray change, and both of alice's and bob's iteration contracts are gone.
  bobHoldings <- query @Coin admin
  case [c.amount | (_, c) <- bobHoldings, c.owner == bob] of
    amounts | length amounts == 2 && sum amounts == 0.02 -> pure ()
    other -> abort ("expected bob to hold exactly two 0.01 coins, got: " <> show other)
  archivedAlice1 <- queryContractId admin (asConcrete (theAllocationCidV2 aliceRes))
  archivedAlice2 <- queryContractId admin (asConcrete nextAliceCid)
  archivedBob1 <- queryContractId admin (asConcrete (theAllocationCidV2 bobRes))
  archivedBob2 <- queryContractId admin (asConcrete nextBobCid)
  archivedAlice1 === None
  archivedAlice2 === None
  archivedBob1 === None
  archivedBob2 === None

----------------------------------------------------------------------
-- Composability: a provider-delegated account as an allocation's authorizer
----------------------------------------------------------------------

-- | An authorizer account with a provider requires BOTH the owner and the
-- provider in @actors@ to allocate -- the input holding's signatories must
-- all be part of the transaction's authority to archive it.
testAllocateV2ProviderAuthorizer : Script ()
testAllocateV2ProviderAuthorizer = do
  admin <- allocateParty "AllocV2ProviderAdmin"
  alice <- allocateParty "AllocV2ProviderAlice"
  aliceProvider <- allocateParty "AllocV2ProviderAliceProvider"
  bob <- allocateParty "AllocV2ProviderBob"
  carol <- allocateParty "AllocV2ProviderCarolExecutor"
  factoryCid <- coinFactorySetup admin
  let instrumentId = InstrumentId with admin, id = "COIN-ALLOCV2-PROVIDER"
      authorizerAcct = providerAccount alice aliceProvider
      settlement = mkSettlement [carol] "settlement-provider"
      spec = AV2.AllocationSpecification with
        admin, authorizer = authorizerAcct
        transferLegSides = [mkLeg "leg-0" AV2.SenderSide bob 0.006 "COIN-ALLOCV2-PROVIDER"]
        settlementDeadline = None, nextIterationFunding = None, committed = False, meta = emptyMetadata
  -- 'mintCoinV2' only produces basic accounts -- create the provider-managed
  -- holding directly, under owner + provider's joint authority.
  coinCid <- submit (actAs admin <> actAs alice <> actAs aliceProvider) do
    createCmd Coin with
      instrumentId, owner = alice, provider = Some aliceProvider, accountId = "", amount = 0.01
  factoryDisc <- discloseFactory admin factoryCid
  t0 <- getTime

  -- Owner alone, missing the provider, is rejected.
  noProviderRes <- trySubmit (actAs alice <> disclose factoryDisc) do
    exerciseCmd (asAllocationFactoryV2 factoryCid) AIV2.AllocationFactory_Allocate with
      settlement, allocation = spec, requestedAt = t0
      inputHoldingCids = [toInterfaceContractId @HoldingV2.Holding coinCid]
      extraArgs = emptyExtraArgs, actors = [alice]
  expectAbort "requires the authorizer account's owner and provider authority" noProviderRes

  -- Owner + provider jointly succeeds; change is credited to the full
  -- authorizer account (owner + provider).
  allocRes <- trySubmit (actAs alice <> actAs aliceProvider <> disclose factoryDisc) do
    exerciseCmd (asAllocationFactoryV2 factoryCid) AIV2.AllocationFactory_Allocate with
      settlement, allocation = spec, requestedAt = t0
      inputHoldingCids = [toInterfaceContractId @HoldingV2.Holding coinCid]
      extraArgs = emptyExtraArgs, actors = [alice, aliceProvider]
  aliceRes <- case allocRes of
    Right ok -> pure ok
    Left err -> abort ("expected AllocationFactory_Allocate to succeed with owner + provider, got: " <> show err)
  let aliceAllocCid = theAllocationCidV2 aliceRes
  case TextMap.lookup "COIN-ALLOCV2-PROVIDER" aliceRes.authorizerChangeCids of
    Some [cid] -> do
      Some c <- queryContractId admin (coerceContractId @HoldingV2.Holding @Coin cid)
      c.owner === alice
      c.provider === Some aliceProvider
      c.amount === 0.004
    other -> abort ("expected allocate-time change of 0.004 credited to the full account, got: " <> show other)

  -- bob's ReceiverSide leg must name alice's FULL account as its otherside --
  -- 'mkLeg' only builds basic othersides, so this one is constructed directly.
  let bobSpec = AV2.AllocationSpecification with
        admin, authorizer = basicAccount bob
        transferLegSides =
          [ AV2.TransferLegSide with
              transferLegId = "leg-0", side = AV2.ReceiverSide, otherside = authorizerAcct
              amount = 0.006, instrumentId = "COIN-ALLOCV2-PROVIDER", meta = emptyMetadata
          ]
        settlementDeadline = None, nextIterationFunding = None, committed = False, meta = emptyMetadata
  bobRes <- allocate factoryCid admin bob settlement bobSpec []
  let transferLegs = [AV2.TransferLeg with
        transferLegId = "leg-0", sender = authorizerAcct, receiver = basicAccount bob
        amount = 0.006, instrumentId = "COIN-ALLOCV2-PROVIDER", meta = emptyMetadata]
  settleRes <- settleBatch factoryCid admin settlement transferLegs
    [finalized aliceAllocCid, finalized (theAllocationCidV2 bobRes)] [carol]
  case settleRes.allocationSettleResults of
    [r1, r2] -> do
      let outputs = [r1.output, r2.output]
      assertMsg "expected both allocations to settle fully with no next iteration"
        (all (\o -> o == AV2.AllocationResult_Settled with nextIterationAllocationCid = None) outputs)
    other -> abort ("expected two settle results, got: " <> show other)
  bobHoldings <- query @Coin admin
  case [c | (_, c) <- bobHoldings, c.owner == bob] of
    [c] -> c.amount === 0.006
    other -> abort ("expected bob to receive exactly one coin, got: " <> show other)

----------------------------------------------------------------------
-- Conservation: total supply plus outstanding lockedAmounts stays constant
----------------------------------------------------------------------

totalSupply : Party -> Text -> Script Decimal
totalSupply admin instr = do
  coins <- query @Coin admin
  pure (sum [c.amount | (_, c) <- coins, c.instrumentId.id == instr])

totalLocked : Party -> Text -> Script Decimal
totalLocked admin instr = do
  allocs <- query @CoinAllocationV2 admin
  pure (sum [a | (_, alloc) <- allocs, Some a <- [TextMap.lookup instr alloc.lockedAmounts]])

totalValue : Party -> Text -> Script Decimal
totalValue admin instr = (+) <$> totalSupply admin instr <*> totalLocked admin instr

nextCid : AV2.AllocationResult -> Script (ContractId AV2.Allocation)
nextCid r = case r.output of
  AV2.AllocationResult_Settled{nextIterationAllocationCid = Some cid} -> pure cid
  other -> abort ("expected a carried-forward allocation, got: " <> show other)

-- | Multi-leg NET settlement: alice and bob are each sender on one leg and
-- receiver on the other, in the same batch.
testNettedTwoWayBatchConservesValue : Script ()
testNettedTwoWayBatchConservesValue = do
  admin <- allocateParty "NetAdmin"
  alice <- allocateParty "NetAlice"
  bob <- allocateParty "NetBob"
  carol <- allocateParty "NetCarolExecutor"
  factoryCid <- coinFactorySetup admin
  let instrX = "COIN-NET-X"
      instrY = "COIN-NET-Y"
  coinX <- mintCoinV2 factoryCid admin (InstrumentId with admin, id = instrX) alice 0.01
  coinY <- mintCoinV2 factoryCid admin (InstrumentId with admin, id = instrY) bob 0.02
  let settlement = mkSettlement [carol] "settlement-net"
      aliceSpec = mkSpec admin alice
        [ mkLeg "leg-x" AV2.SenderSide bob 0.01 instrX
        , mkLeg "leg-y" AV2.ReceiverSide bob 0.02 instrY
        ]
      bobSpec = mkSpec admin bob
        [ mkLeg "leg-x" AV2.ReceiverSide alice 0.01 instrX
        , mkLeg "leg-y" AV2.SenderSide alice 0.02 instrY
        ]
      transferLegs =
        [ AV2.TransferLeg with
            transferLegId = "leg-x", sender = basicAccount alice, receiver = basicAccount bob
            amount = 0.01, instrumentId = instrX, meta = emptyMetadata
        , AV2.TransferLeg with
            transferLegId = "leg-y", sender = basicAccount bob, receiver = basicAccount alice
            amount = 0.02, instrumentId = instrY, meta = emptyMetadata
        ]
  aliceRes <- allocate factoryCid admin alice settlement aliceSpec [coinX]
  bobRes <- allocate factoryCid admin bob settlement bobSpec [coinY]
  _ <- settleBatch factoryCid admin settlement transferLegs
    [finalized (theAllocationCidV2 aliceRes), finalized (theAllocationCidV2 bobRes)] [carol]
  vx <- totalValue admin instrX
  vy <- totalValue admin instrY
  vx === 0.01
  vy === 0.02
  coins <- query @Coin admin
  [c.amount | (_, c) <- coins, c.owner == bob, c.instrumentId.id == instrX] === [0.01]
  [c.amount | (_, c) <- coins, c.owner == alice, c.instrumentId.id == instrY] === [0.02]

-- | An extra SenderSide leg naming an instrument with NO locked balance --
-- 'fromOptional 0.0' must fail closed, not treat a missing key as unlimited.
testExtraSenderLegOnUnlockedInstrumentRejected : Script ()
testExtraSenderLegOnUnlockedInstrumentRejected = do
  admin <- allocateParty "UnlockedAdmin"
  alice <- allocateParty "UnlockedAlice"
  bob <- allocateParty "UnlockedBob"
  carol <- allocateParty "UnlockedCarolExecutor"
  factoryCid <- coinFactorySetup admin
  let instrA = "COIN-UNLOCKED-A"
      instrB = "COIN-UNLOCKED-B"
  coinA <- mintCoinV2 factoryCid admin (InstrumentId with admin, id = instrA) alice 0.01
  let settlement = mkSettlement [carol] "settlement-unlocked"
      aliceSpec = (mkSpec admin alice [mkLeg "leg-0" AV2.SenderSide bob 0.01 instrA])
        with nextIterationFunding = Some TextMap.empty
      bobSpec = (mkSpec admin bob [mkLeg "leg-0" AV2.ReceiverSide alice 0.01 instrA])
        with nextIterationFunding = Some TextMap.empty
      transferLegs =
        [ AV2.TransferLeg with
            transferLegId = "leg-0", sender = basicAccount alice, receiver = basicAccount bob
            amount = 0.01, instrumentId = instrA, meta = emptyMetadata
        , AV2.TransferLeg with
            transferLegId = "leg-b", sender = basicAccount alice, receiver = basicAccount bob
            amount = 99.0, instrumentId = instrB, meta = emptyMetadata
        ]
  aliceRes <- allocate factoryCid admin alice settlement aliceSpec [coinA]
  bobRes <- allocate factoryCid admin bob settlement bobSpec []
  res <- trySettleBatch factoryCid admin settlement transferLegs
    [ AV2.FinalizedAllocation with
        allocationCid = theAllocationCidV2 aliceRes
        extraTransferLegSides = [mkLeg "leg-b" AV2.SenderSide bob 99.0 instrB]
        nextIterationFunding = None
    , AV2.FinalizedAllocation with
        allocationCid = theAllocationCidV2 bobRes
        extraTransferLegSides = [mkLeg "leg-b" AV2.ReceiverSide alice 99.0 instrB]
        nextIterationFunding = None
    ] [carol]
  case res of
    Left _ -> pure ()
    Right _ -> do
      v <- totalValue admin instrB
      abort ("unlocked-instrument SenderSide leg accepted; instrument B value now " <> show v)

-- | A carry naming an instrument that has no @remaining@ balance at all.
testCarryOnUnknownInstrumentRejected : Script ()
testCarryOnUnknownInstrumentRejected = do
  admin <- allocateParty "CarryUnknownAdmin"
  alice <- allocateParty "CarryUnknownAlice"
  bob <- allocateParty "CarryUnknownBob"
  carol <- allocateParty "CarryUnknownCarolExecutor"
  factoryCid <- coinFactorySetup admin
  let instr = "COIN-CARRYUNKNOWN"
  coinCid <- mintCoinV2 factoryCid admin (InstrumentId with admin, id = instr) alice 0.02
  let settlement = mkSettlement [carol] "settlement-carryunknown"
      aliceSpec = (mkSpec admin alice [mkLeg "leg-0" AV2.SenderSide bob 0.01 instr])
        with nextIterationFunding = Some (TextMap.fromList [(instr, 0.01)])
      bobSpec = mkSpec admin bob [mkLeg "leg-0" AV2.ReceiverSide alice 0.01 instr]
      transferLegs = [AV2.TransferLeg with
        transferLegId = "leg-0", sender = basicAccount alice, receiver = basicAccount bob
        amount = 0.01, instrumentId = instr, meta = emptyMetadata]
  aliceRes <- allocate factoryCid admin alice settlement aliceSpec [coinCid]
  bobRes <- allocate factoryCid admin bob settlement bobSpec []
  res <- trySettleBatch factoryCid admin settlement transferLegs
    [ AV2.FinalizedAllocation with
        allocationCid = theAllocationCidV2 aliceRes, extraTransferLegSides = []
        nextIterationFunding = Some (TextMap.fromList [("COIN-NOT-AN-INSTRUMENT", 7.0)])
    , finalized (theAllocationCidV2 bobRes)
    ] [carol]
  case res of
    Left _ -> pure ()
    Right _ -> abort "carry on an instrument with no remaining balance was accepted"

-- | Extras / carry on an allocation that never enabled iterated settlement.
testExtrasRejectedWhenIterationDisabled : Script ()
testExtrasRejectedWhenIterationDisabled = do
  admin <- allocateParty "NoIterAdmin"
  alice <- allocateParty "NoIterAlice"
  bob <- allocateParty "NoIterBob"
  carol <- allocateParty "NoIterCarolExecutor"
  factoryCid <- coinFactorySetup admin
  let instr = "COIN-NOITER"
  coinCid <- mintCoinV2 factoryCid admin (InstrumentId with admin, id = instr) alice 0.02
  let settlement = mkSettlement [carol] "settlement-noiter"
      aliceSpec = mkSpec admin alice [mkLeg "leg-0" AV2.SenderSide bob 0.01 instr]
      bobSpec = mkSpec admin bob [mkLeg "leg-0" AV2.ReceiverSide alice 0.01 instr]
      transferLegs = [AV2.TransferLeg with
        transferLegId = "leg-0", sender = basicAccount alice, receiver = basicAccount bob
        amount = 0.01, instrumentId = instr, meta = emptyMetadata]
  aliceRes <- allocate factoryCid admin alice settlement aliceSpec [coinCid]
  bobRes <- allocate factoryCid admin bob settlement bobSpec []
  res <- trySettleBatch factoryCid admin settlement transferLegs
    [ AV2.FinalizedAllocation with
        allocationCid = theAllocationCidV2 aliceRes, extraTransferLegSides = []
        nextIterationFunding = Some (TextMap.fromList [(instr, 0.005)])
    , finalized (theAllocationCidV2 bobRes)
    ] [carol]
  case res of
    Left _ -> pure ()
    Right _ -> abort "nextIterationFunding accepted on a non-iterated allocation"

-- | A zero-amount extra leg: the guard is @> 0.0@, so 0.0 must be rejected.
testZeroAmountExtraLegRejected : Script ()
testZeroAmountExtraLegRejected = do
  admin <- allocateParty "ZeroExtraAdmin"
  alice <- allocateParty "ZeroExtraAlice"
  bob <- allocateParty "ZeroExtraBob"
  carol <- allocateParty "ZeroExtraCarolExecutor"
  factoryCid <- coinFactorySetup admin
  let instr = "COIN-ZEROEXTRA"
  coinCid <- mintCoinV2 factoryCid admin (InstrumentId with admin, id = instr) alice 0.01
  let settlement = mkSettlement [carol] "settlement-zeroextra"
      aliceSpec = (mkSpec admin alice [mkLeg "leg-0" AV2.SenderSide bob 0.01 instr])
        with nextIterationFunding = Some TextMap.empty
      bobSpec = (mkSpec admin bob [mkLeg "leg-0" AV2.ReceiverSide alice 0.01 instr])
        with nextIterationFunding = Some TextMap.empty
      transferLegs =
        [ AV2.TransferLeg with
            transferLegId = "leg-0", sender = basicAccount alice, receiver = basicAccount bob
            amount = 0.01, instrumentId = instr, meta = emptyMetadata
        , AV2.TransferLeg with
            transferLegId = "leg-z", sender = basicAccount alice, receiver = basicAccount bob
            amount = 0.0, instrumentId = instr, meta = emptyMetadata
        ]
  aliceRes <- allocate factoryCid admin alice settlement aliceSpec [coinCid]
  bobRes <- allocate factoryCid admin bob settlement bobSpec []
  res <- trySettleBatch factoryCid admin settlement transferLegs
    [ AV2.FinalizedAllocation with
        allocationCid = theAllocationCidV2 aliceRes
        extraTransferLegSides = [mkLeg "leg-z" AV2.SenderSide bob 0.0 instr]
        nextIterationFunding = None
    , AV2.FinalizedAllocation with
        allocationCid = theAllocationCidV2 bobRes
        extraTransferLegSides = [mkLeg "leg-z" AV2.ReceiverSide alice 0.0 instr]
        nextIterationFunding = None
    ] [carol]
  case res of
    Left _ -> pure ()
    Right _ -> abort "zero-amount extra leg accepted"

-- | An allocation may be settled once only; a second batch naming the same
-- (now archived) cid must fail rather than re-mint. Also: the same cid listed
-- twice within one batch.
testAllocationCannotSettleTwice : Script ()
testAllocationCannotSettleTwice = do
  admin <- allocateParty "TwiceAdmin"
  alice <- allocateParty "TwiceAlice"
  bob <- allocateParty "TwiceBob"
  carol <- allocateParty "TwiceCarolExecutor"
  factoryCid <- coinFactorySetup admin
  let instr = "COIN-TWICE"
  coinCid <- mintCoinV2 factoryCid admin (InstrumentId with admin, id = instr) alice 0.01
  let settlement = mkSettlement [carol] "settlement-twice"
      aliceSpec = mkSpec admin alice [mkLeg "leg-0" AV2.SenderSide bob 0.01 instr]
      bobSpec = mkSpec admin bob [mkLeg "leg-0" AV2.ReceiverSide alice 0.01 instr]
      transferLegs = [AV2.TransferLeg with
        transferLegId = "leg-0", sender = basicAccount alice, receiver = basicAccount bob
        amount = 0.01, instrumentId = instr, meta = emptyMetadata]
  aliceRes <- allocate factoryCid admin alice settlement aliceSpec [coinCid]
  bobRes <- allocate factoryCid admin bob settlement bobSpec []
  let aliceCid = theAllocationCidV2 aliceRes
      bobCid = theAllocationCidV2 bobRes
  _ <- settleBatch factoryCid admin settlement transferLegs [finalized aliceCid, finalized bobCid] [carol]
  replay <- trySettleBatch factoryCid admin settlement transferLegs
    [finalized aliceCid, finalized bobCid] [carol]
  case replay of
    Left _ -> pure ()
    Right _ -> abort "settled allocation was settled a second time"
  coin2 <- mintCoinV2 factoryCid admin (InstrumentId with admin, id = instr) alice 0.01
  alice2 <- allocate factoryCid admin alice settlement aliceSpec [coin2]
  bob2 <- allocate factoryCid admin bob settlement bobSpec []
  dup <- trySettleBatch factoryCid admin settlement transferLegs
    [ finalized (theAllocationCidV2 alice2)
    , finalized (theAllocationCidV2 alice2)
    , finalized (theAllocationCidV2 bob2)
    ] [carol]
  case dup of
    Left _ -> pure ()
    Right _ -> abort "the same allocation was accepted twice in one batch"
  v <- totalValue admin instr
  v === 0.02

-- | Settling after a cancel, and cancelling after a settle, must both fail.
testNoSettleAfterCancelOrWithdraw : Script ()
testNoSettleAfterCancelOrWithdraw = do
  admin <- allocateParty "AfterAdmin"
  alice <- allocateParty "AfterAlice"
  bob <- allocateParty "AfterBob"
  carol <- allocateParty "AfterCarolExecutor"
  factoryCid <- coinFactorySetup admin
  let instr = "COIN-AFTER"
  coinCid <- mintCoinV2 factoryCid admin (InstrumentId with admin, id = instr) alice 0.01
  let settlement = mkSettlement [carol] "settlement-after"
      aliceSpec = mkSpec admin alice [mkLeg "leg-0" AV2.SenderSide bob 0.01 instr]
      bobSpec = mkSpec admin bob [mkLeg "leg-0" AV2.ReceiverSide alice 0.01 instr]
      transferLegs = [AV2.TransferLeg with
        transferLegId = "leg-0", sender = basicAccount alice, receiver = basicAccount bob
        amount = 0.01, instrumentId = instr, meta = emptyMetadata]
  aliceRes <- allocate factoryCid admin alice settlement aliceSpec [coinCid]
  bobRes <- allocate factoryCid admin bob settlement bobSpec []
  let aliceCid = theAllocationCidV2 aliceRes
  _ <- submit carol do
    exerciseCmd aliceCid AV2.Allocation_Cancel with actors = [carol], extraArgs = emptyExtraArgs
  v1 <- totalValue admin instr
  v1 === 0.01
  res <- trySettleBatch factoryCid admin settlement transferLegs
    [finalized aliceCid, finalized (theAllocationCidV2 bobRes)] [carol]
  case res of
    Left _ -> pure ()
    Right _ -> abort "a cancelled allocation was settled"
  v2 <- totalValue admin instr
  v2 === 0.01

testHappyPathConservesValue : Script ()
testHappyPathConservesValue = do
  admin <- allocateParty "HappyAdmin"
  alice <- allocateParty "HappyAlice"
  bob <- allocateParty "HappyBob"
  carol <- allocateParty "HappyCarolExecutor"
  factoryCid <- coinFactorySetup admin
  let instr = "COIN-HAPPY"
      instrumentId = InstrumentId with admin, id = instr
  coinCid <- mintCoinV2 factoryCid admin instrumentId alice 0.006
  v0 <- totalValue admin instr
  v0 === 0.006
  let settlement = mkSettlement [carol] "settlement-happy"
      aliceSpec = mkSpec admin alice [mkLeg "leg-0" AV2.SenderSide bob 0.006 instr]
      bobSpec = mkSpec admin bob [mkLeg "leg-0" AV2.ReceiverSide alice 0.006 instr]
  aliceRes <- allocate factoryCid admin alice settlement aliceSpec [coinCid]
  bobRes <- allocate factoryCid admin bob settlement bobSpec []
  v1 <- totalValue admin instr
  v1 === 0.006
  let transferLegs = [AV2.TransferLeg with
        transferLegId = "leg-0", sender = basicAccount alice, receiver = basicAccount bob
        amount = 0.006, instrumentId = instr, meta = emptyMetadata]
  _ <- settleBatch factoryCid admin settlement transferLegs
    [finalized (theAllocationCidV2 aliceRes), finalized (theAllocationCidV2 bobRes)] [carol]
  v2 <- totalValue admin instr
  v2 === 0.006

----------------------------------------------------------------------
-- Naked Allocation_Settle: caller-forgeable settleBatchContextKey mints
-- unbacked supply by design
----------------------------------------------------------------------

testNakedSettleReceiverSideMintsUnbackedByDesign : Script ()
testNakedSettleReceiverSideMintsUnbackedByDesign = do
  admin <- allocateParty "NakedAdmin"
  alice <- allocateParty "NakedAlice"
  bob <- allocateParty "NakedBob"
  carol <- allocateParty "NakedCarolExecutor"
  factoryCid <- coinFactorySetup admin
  let instr = "COIN-NAKED-UNBACKED"
      settlement = mkSettlement [carol] "settlement-naked-unbacked"
      bobSpec = mkSpec admin bob [mkLeg "leg-0" AV2.ReceiverSide alice 5.0 instr]
  bobRes <- allocate factoryCid admin bob settlement bobSpec []
  before <- totalValue admin instr
  before === 0.0
  let forged = withSettleBatchContext emptyExtraArgs
  settleRes <- submit (actAs admin <> actAs carol) do
    exerciseCmd (theAllocationCidV2 bobRes) AV2.Allocation_Settle with
      actors = [admin, carol], extraTransferLegSides = [], nextIterationFunding = None
      extraArgs = forged
  settleRes.output === AV2.AllocationResult_Settled with nextIterationAllocationCid = None
  after <- totalValue admin instr
  assertMsg ("naked settle minted unbacked value: " <> show before <> " -> " <> show after)
    (after == 5.0)

----------------------------------------------------------------------
-- Iterated settlement over three rounds, with extraTransferLegSides
----------------------------------------------------------------------

testThreeRoundIteratedConservation : Script ()
testThreeRoundIteratedConservation = do
  admin <- allocateParty "Iter3Admin"
  alice <- allocateParty "Iter3Alice"
  bob <- allocateParty "Iter3Bob"
  carol <- allocateParty "Iter3CarolExecutor"
  factoryCid <- coinFactorySetup admin
  let instr = "COIN-ITER3"
      instrumentId = InstrumentId with admin, id = instr
  coinCid <- mintCoinV2 factoryCid admin instrumentId alice 0.05
  let settlement = mkSettlement [carol] "settlement-iter3"
      aliceSpec = (mkSpec admin alice [mkLeg "leg-0" AV2.SenderSide bob 0.01 instr])
        with nextIterationFunding = Some (TextMap.fromList [(instr, 0.04)])
      bobSpec = (mkSpec admin bob [mkLeg "leg-0" AV2.ReceiverSide alice 0.01 instr])
        with nextIterationFunding = Some TextMap.empty
      transferLegs = [AV2.TransferLeg with
        transferLegId = "leg-0", sender = basicAccount alice, receiver = basicAccount bob
        amount = 0.01, instrumentId = instr, meta = emptyMetadata]
  aliceRes <- allocate factoryCid admin alice settlement aliceSpec [coinCid]
  bobRes <- allocate factoryCid admin bob settlement bobSpec []
  v0 <- totalValue admin instr
  v0 === 0.05

  let carryOf a = AV2.FinalizedAllocation with
        allocationCid = a, extraTransferLegSides = []
        nextIterationFunding = Some TextMap.empty
      carryAmt a x = AV2.FinalizedAllocation with
        allocationCid = a, extraTransferLegSides = []
        nextIterationFunding = Some (TextMap.fromList [(instr, x)])

  -- Round 1: spend 0.01, carry 0.03 (0.04 locked remains, so 0.01 comes back).
  r1 <- settleBatch factoryCid admin settlement transferLegs
    [carryAmt (theAllocationCidV2 aliceRes) 0.03, carryOf (theAllocationCidV2 bobRes)] [carol]
  let [a1, b1] = r1.allocationSettleResults
  v1 <- totalValue admin instr
  v1 === 0.05
  aNext1 <- nextCid a1
  bNext1 <- nextCid b1

  -- Round 2: standing leg recurs, plus an additive extra leg for this round only.
  let extraLegs = [ mkLeg "leg-x" AV2.SenderSide bob 0.005 instr ]
      extraRecv = [ mkLeg "leg-x" AV2.ReceiverSide alice 0.005 instr ]
      transferLegs2 = transferLegs ++
        [AV2.TransferLeg with
          transferLegId = "leg-x", sender = basicAccount alice, receiver = basicAccount bob
          amount = 0.005, instrumentId = instr, meta = emptyMetadata]
  r2 <- settleBatch factoryCid admin settlement transferLegs2
    [ AV2.FinalizedAllocation with
        allocationCid = aNext1, extraTransferLegSides = extraLegs
        nextIterationFunding = Some (TextMap.fromList [(instr, 0.01)])
    , AV2.FinalizedAllocation with
        allocationCid = bNext1, extraTransferLegSides = extraRecv
        nextIterationFunding = Some TextMap.empty
    ] [carol]
  let [a2, b2] = r2.allocationSettleResults
  v2 <- totalValue admin instr
  v2 === 0.05
  aNext2 <- nextCid a2
  bNext2 <- nextCid b2

  -- Round 3: final round, no carry.
  r3 <- settleBatch factoryCid admin settlement transferLegs
    [finalized aNext2, finalized bNext2] [carol]
  let [a3, b3] = r3.allocationSettleResults
  a3.output === AV2.AllocationResult_Settled with nextIterationAllocationCid = None
  b3.output === AV2.AllocationResult_Settled with nextIterationAllocationCid = None
  v3 <- totalValue admin instr
  v3 === 0.05
  locked <- totalLocked admin instr
  locked === 0.0
  bobTotal <- do
    coins <- query @Coin admin
    pure (sum [c.amount | (_, c) <- coins, c.owner == bob, c.instrumentId.id == instr])
  bobTotal === 0.035

-- | A carry larger than what remains after the round's spend must be
-- rejected -- otherwise the successor would be funded with value already
-- handed to the counterparty.
testCarryCannotExceedRemaining : Script ()
testCarryCannotExceedRemaining = do
  admin <- allocateParty "CarryAdmin"
  alice <- allocateParty "CarryAlice"
  bob <- allocateParty "CarryBob"
  carol <- allocateParty "CarryCarolExecutor"
  factoryCid <- coinFactorySetup admin
  let instr = "COIN-CARRY"
      instrumentId = InstrumentId with admin, id = instr
  coinCid <- mintCoinV2 factoryCid admin instrumentId alice 0.02
  let settlement = mkSettlement [carol] "settlement-carry"
      aliceSpec = (mkSpec admin alice [mkLeg "leg-0" AV2.SenderSide bob 0.01 instr])
        with nextIterationFunding = Some (TextMap.fromList [(instr, 0.01)])
      bobSpec = mkSpec admin bob [mkLeg "leg-0" AV2.ReceiverSide alice 0.01 instr]
      transferLegs = [AV2.TransferLeg with
        transferLegId = "leg-0", sender = basicAccount alice, receiver = basicAccount bob
        amount = 0.01, instrumentId = instr, meta = emptyMetadata]
  aliceRes <- allocate factoryCid admin alice settlement aliceSpec [coinCid]
  bobRes <- allocate factoryCid admin bob settlement bobSpec []
  -- locked 0.02, spends 0.01, so remaining is 0.01 -- ask for 0.0100000001.
  res <- trySettleBatch factoryCid admin settlement transferLegs
    [ AV2.FinalizedAllocation with
        allocationCid = theAllocationCidV2 aliceRes, extraTransferLegSides = []
        nextIterationFunding = Some (TextMap.fromList [(instr, 0.0100000001)])
    , finalized (theAllocationCidV2 bobRes)
    ] [carol]
  case res of
    Left _ -> pure ()
    Right _ -> abort "carry exceeding remaining was accepted -- conservation broken"

----------------------------------------------------------------------
-- Deadline boundary
----------------------------------------------------------------------

-- | @settle@ allows @now <= deadline@ and committed @withdraw@ allows
-- @now > deadline@ -- checks there is no instant at which BOTH are open.
testSettleAndWithdrawAreDisjointAtDeadline : Script ()
testSettleAndWithdrawAreDisjointAtDeadline = do
  admin <- allocateParty "DeadlineAdmin"
  alice <- allocateParty "DeadlineAlice"
  bob <- allocateParty "DeadlineBob"
  carol <- allocateParty "DeadlineCarolExecutor"
  factoryCid <- coinFactorySetup admin
  let instr = "COIN-DEADLINE"
      instrumentId = InstrumentId with admin, id = instr
  coinCid <- mintCoinV2 factoryCid admin instrumentId alice 0.01
  t0 <- getTime
  let settlement = mkSettlement [carol] "settlement-deadline"
      aliceSpec = (mkSpec admin alice [mkLeg "leg-0" AV2.SenderSide bob 0.01 instr])
        with committed = True, settlementDeadline = Some t0
      bobSpec = mkSpec admin bob [mkLeg "leg-0" AV2.ReceiverSide alice 0.01 instr]
      transferLegs = [AV2.TransferLeg with
        transferLegId = "leg-0", sender = basicAccount alice, receiver = basicAccount bob
        amount = 0.01, instrumentId = instr, meta = emptyMetadata]
  aliceRes <- allocate factoryCid admin alice settlement aliceSpec [coinCid]
  bobRes <- allocate factoryCid admin bob settlement bobSpec []
  -- Exactly AT the deadline: withdraw must be closed...
  submitMustFail alice do
    exerciseCmd (theAllocationCidV2 aliceRes) AV2.Allocation_Withdraw with
      actors = [alice], extraArgs = emptyExtraArgs
  -- ...and settle must still be open.
  _ <- settleBatch factoryCid admin settlement transferLegs
    [finalized (theAllocationCidV2 aliceRes), finalized (theAllocationCidV2 bobRes)] [carol]
  v <- totalValue admin instr
  v === 0.01

----------------------------------------------------------------------
-- Pure TextMap arithmetic
----------------------------------------------------------------------

testTextMapArithmetic : Script ()
testTextMapArithmetic = do
  other <- allocateParty "MathOtherside"
  let a = TextMap.fromList [("x", 10.0), ("y", 5.0)]
      b = TextMap.fromList [("x", 3.0), ("z", 7.0)]
  textMapUnionWith (+) a b === TextMap.fromList [("x", 13.0), ("y", 5.0), ("z", 7.0)]
  textMapUnionWith (+) a TextMap.empty === a
  textMapUnionWith (+) TextMap.empty a === a
  textMapNegate a === TextMap.fromList [("x", -10.0), ("y", -5.0)]
  textMapUnionWith (+) a (textMapNegate a) === TextMap.fromList [("x", 0.0), ("y", 0.0)]
  -- Duplicate legIds within one side must SUM, not overwrite.
  let sides =
        [ mkLeg "L1" AV2.SenderSide other 1.0 "x"
        , mkLeg "L1" AV2.SenderSide other 2.0 "x"
        , mkLeg "L2" AV2.ReceiverSide other 4.0 "x"
        ]
  sumSide AV2.SenderSide sides === TextMap.fromList [("x", 3.0)]
  sumSide AV2.ReceiverSide sides === TextMap.fromList [("x", 4.0)]
  sumSide AV2.SenderSide [] === (TextMap.empty : TextMap.TextMap Decimal)

----------------------------------------------------------------------
-- SettleBatch's per-leg consistency checks -- the core soundness gate
----------------------------------------------------------------------

-- | The two sides of a leg disagree on the amount: the sender's decrement and
-- the receiver's mint would differ, which is exactly a conservation break.
testLegAmountMismatchRejected : Script ()
testLegAmountMismatchRejected = do
  admin <- allocateParty "AmtAdmin"
  alice <- allocateParty "AmtAlice"
  bob <- allocateParty "AmtBob"
  carol <- allocateParty "AmtCarolExecutor"
  factoryCid <- coinFactorySetup admin
  let instr = "COIN-AMT"
  coinCid <- mintCoinV2 factoryCid admin (InstrumentId with admin, id = instr) alice 0.01
  let settlement = mkSettlement [carol] "settlement-amt"
      aliceSpec = mkSpec admin alice [mkLeg "leg-0" AV2.SenderSide bob 0.001 instr]
      bobSpec = mkSpec admin bob [mkLeg "leg-0" AV2.ReceiverSide alice 0.01 instr]
  aliceRes <- allocate factoryCid admin alice settlement aliceSpec [coinCid]
  bobRes <- allocate factoryCid admin bob settlement bobSpec []
  let mkBatch amt = [AV2.TransferLeg with
        transferLegId = "leg-0", sender = basicAccount alice, receiver = basicAccount bob
        amount = amt, instrumentId = instr, meta = emptyMetadata]
      fas = [finalized (theAllocationCidV2 aliceRes), finalized (theAllocationCidV2 bobRes)]
  lo <- trySettleBatch factoryCid admin settlement (mkBatch 0.001) fas [carol]
  hi <- trySettleBatch factoryCid admin settlement (mkBatch 0.01) fas [carol]
  case (lo, hi) of
    (Left _, Left _) -> pure ()
    _ -> do
      v <- totalValue admin instr
      abort ("mismatched leg amounts settled; value now " <> show v)

-- | The two sides of a leg disagree on the instrument.
testLegInstrumentMismatchRejected : Script ()
testLegInstrumentMismatchRejected = do
  admin <- allocateParty "InstrAdmin"
  alice <- allocateParty "InstrAlice"
  bob <- allocateParty "InstrBob"
  carol <- allocateParty "InstrCarolExecutor"
  factoryCid <- coinFactorySetup admin
  let instrA = "COIN-INSTR-A"
      instrB = "COIN-INSTR-B"
  coinCid <- mintCoinV2 factoryCid admin (InstrumentId with admin, id = instrA) alice 0.01
  let settlement = mkSettlement [carol] "settlement-instr"
      aliceSpec = mkSpec admin alice [mkLeg "leg-0" AV2.SenderSide bob 0.01 instrA]
      bobSpec = mkSpec admin bob [mkLeg "leg-0" AV2.ReceiverSide alice 0.01 instrB]
  aliceRes <- allocate factoryCid admin alice settlement aliceSpec [coinCid]
  bobRes <- allocate factoryCid admin bob settlement bobSpec []
  let fas = [finalized (theAllocationCidV2 aliceRes), finalized (theAllocationCidV2 bobRes)]
      mkBatch i = [AV2.TransferLeg with
        transferLegId = "leg-0", sender = basicAccount alice, receiver = basicAccount bob
        amount = 0.01, instrumentId = i, meta = emptyMetadata]
  ra <- trySettleBatch factoryCid admin settlement (mkBatch instrA) fas [carol]
  rb <- trySettleBatch factoryCid admin settlement (mkBatch instrB) fas [carol]
  case (ra, rb) of
    (Left _, Left _) -> pure ()
    _ -> do
      va <- totalValue admin instrA
      vb <- totalValue admin instrB
      abort ("cross-instrument leg settled; A=" <> show va <> " B=" <> show vb)

-- | Allocations minted for a DIFFERENT settlement must not be usable in this
-- batch.
testForeignSettlementAllocationRejected : Script ()
testForeignSettlementAllocationRejected = do
  admin <- allocateParty "FsAdmin"
  alice <- allocateParty "FsAlice"
  bob <- allocateParty "FsBob"
  carol <- allocateParty "FsCarolExecutor"
  factoryCid <- coinFactorySetup admin
  let instr = "COIN-FS"
  coinCid <- mintCoinV2 factoryCid admin (InstrumentId with admin, id = instr) alice 0.01
  let s1 = mkSettlement [carol] "settlement-fs-1"
      s2 = mkSettlement [carol] "settlement-fs-2"
      aliceSpec = mkSpec admin alice [mkLeg "leg-0" AV2.SenderSide bob 0.01 instr]
      bobSpec = mkSpec admin bob [mkLeg "leg-0" AV2.ReceiverSide alice 0.01 instr]
      transferLegs = [AV2.TransferLeg with
        transferLegId = "leg-0", sender = basicAccount alice, receiver = basicAccount bob
        amount = 0.01, instrumentId = instr, meta = emptyMetadata]
  aliceRes <- allocate factoryCid admin alice s1 aliceSpec [coinCid]
  bobRes <- allocate factoryCid admin bob s2 bobSpec []
  res <- trySettleBatch factoryCid admin s1 transferLegs
    [finalized (theAllocationCidV2 aliceRes), finalized (theAllocationCidV2 bobRes)] [carol]
  case res of
    Left _ -> pure ()
    Right _ -> abort "an allocation from another settlement was accepted"

-- | An empty batch, and a batch with duplicate leg ids.
testDegenerateBatchesRejected : Script ()
testDegenerateBatchesRejected = do
  admin <- allocateParty "DegAdmin"
  alice <- allocateParty "DegAlice"
  bob <- allocateParty "DegBob"
  carol <- allocateParty "DegCarolExecutor"
  factoryCid <- coinFactorySetup admin
  let instr = "COIN-DEG"
  coinCid <- mintCoinV2 factoryCid admin (InstrumentId with admin, id = instr) alice 0.01
  let settlement = mkSettlement [carol] "settlement-deg"
      aliceSpec = mkSpec admin alice [mkLeg "leg-0" AV2.SenderSide bob 0.01 instr]
      bobSpec = mkSpec admin bob [mkLeg "leg-0" AV2.ReceiverSide alice 0.01 instr]
      leg = AV2.TransferLeg with
        transferLegId = "leg-0", sender = basicAccount alice, receiver = basicAccount bob
        amount = 0.01, instrumentId = instr, meta = emptyMetadata
  aliceRes <- allocate factoryCid admin alice settlement aliceSpec [coinCid]
  bobRes <- allocate factoryCid admin bob settlement bobSpec []
  let fas = [finalized (theAllocationCidV2 aliceRes), finalized (theAllocationCidV2 bobRes)]
  emptyRes <- trySettleBatch factoryCid admin settlement [] fas [carol]
  case emptyRes of
    Left _ -> pure ()
    Right _ -> abort "empty transferLegs accepted"
  dupRes <- trySettleBatch factoryCid admin settlement [leg, leg] fas [carol]
  case dupRes of
    Left _ -> pure ()
    Right _ -> abort "duplicate transferLegId accepted"

----------------------------------------------------------------------
-- Successor lineage
----------------------------------------------------------------------

-- | @originalAllocationCid@ must keep pointing at the ROUND-1 allocation
-- across every later round, not at the immediate predecessor.
testLineagePointsAtRoundOneAcrossRounds : Script ()
testLineagePointsAtRoundOneAcrossRounds = do
  admin <- allocateParty "LinAdmin"
  alice <- allocateParty "LinAlice"
  bob <- allocateParty "LinBob"
  carol <- allocateParty "LinCarolExecutor"
  factoryCid <- coinFactorySetup admin
  let instr = "COIN-LINEAGE"
  coinCid <- mintCoinV2 factoryCid admin (InstrumentId with admin, id = instr) alice 0.03
  let settlement = mkSettlement [carol] "settlement-lineage"
      aliceSpec = (mkSpec admin alice [mkLeg "leg-0" AV2.SenderSide bob 0.01 instr])
        with nextIterationFunding = Some (TextMap.fromList [(instr, 0.02)])
      bobSpec = (mkSpec admin bob [mkLeg "leg-0" AV2.ReceiverSide alice 0.01 instr])
        with nextIterationFunding = Some TextMap.empty
      transferLegs = [AV2.TransferLeg with
        transferLegId = "leg-0", sender = basicAccount alice, receiver = basicAccount bob
        amount = 0.01, instrumentId = instr, meta = emptyMetadata]
  aliceRes <- allocate factoryCid admin alice settlement aliceSpec [coinCid]
  bobRes <- allocate factoryCid admin bob settlement bobSpec []
  let originalAlice = theAllocationCidV2 aliceRes
      carryAmt a x = AV2.FinalizedAllocation with
        allocationCid = a, extraTransferLegSides = []
        nextIterationFunding = Some (TextMap.fromList [(instr, x)])
      carryNone a = AV2.FinalizedAllocation with
        allocationCid = a, extraTransferLegSides = []
        nextIterationFunding = Some TextMap.empty
  -- locked 0.03, spend 0.01 => remaining 0.02, all carried.
  r1 <- settleBatch factoryCid admin settlement transferLegs
    [carryAmt originalAlice 0.02, carryNone (theAllocationCidV2 bobRes)] [carol]
  let [a1, b1] = r1.allocationSettleResults
  aNext1 <- nextCid a1
  bNext1 <- nextCid b1
  Some gen1 <- queryContractId admin (asConcrete aNext1)
  gen1.numIterations === 1
  gen1.originalAllocationCid === Some originalAlice
  r2 <- settleBatch factoryCid admin settlement transferLegs
    [carryAmt aNext1 0.005, carryNone bNext1] [carol]
  let [a2, _] = r2.allocationSettleResults
  aNext2 <- nextCid a2
  Some gen2 <- queryContractId admin (asConcrete aNext2)
  gen2.numIterations === 2
  -- Still the ORIGINAL, not aNext1.
  gen2.originalAllocationCid === Some originalAlice
