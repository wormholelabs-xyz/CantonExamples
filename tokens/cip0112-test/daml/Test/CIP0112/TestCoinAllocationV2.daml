testSettleBatchRejectsUncoveredAllocationSides : Script ()
testSettleBatchRejectsUncoveredAllocationSides = do
  admin <- allocateParty "SettleUncoveredAdmin"
  alice <- allocateParty "SettleUncoveredAlice"
  bob <- allocateParty "SettleUncoveredBob"
  dave <- allocateParty "SettleUncoveredDave"
  carol <- allocateParty "SettleUncoveredCarolExecutor"
  factoryCid <- coinFactorySetup admin
  let instrumentId = InstrumentId with admin, id = "COIN-SETTLE-UNCOVERED"
  coinCid <- mintCoinV2 factoryCid admin instrumentId alice 0.012
  let settlement = mkSettlement [carol] "settlement-uncovered"
      -- alice authorizes TWO legs, but only leg-0 will be in the batch's transferLegs.
      aliceSpec = mkSpec admin alice
        [ mkLeg "leg-0" AV2.SenderSide bob 0.006 "COIN-SETTLE-UNCOVERED"
        , mkLeg "leg-1" AV2.SenderSide dave 0.006 "COIN-SETTLE-UNCOVERED"
        ]
      bobSpec = mkSpec admin bob [mkLeg "leg-0" AV2.ReceiverSide alice 0.006 "COIN-SETTLE-UNCOVERED"]
  aliceRes <- allocate factoryCid admin alice settlement aliceSpec [coinCid]
  bobRes <- allocate factoryCid admin bob settlement bobSpec []
  let transferLegs = [AV2.TransferLeg with
        transferLegId = "leg-0", sender = basicAccount alice, receiver = basicAccount bob
        amount = 0.006, instrumentId = "COIN-SETTLE-UNCOVERED", meta = emptyMetadata]
  res <- trySettleBatch factoryCid admin settlement transferLegs
    [finalized (theAllocationCidV2 aliceRes), finalized (theAllocationCidV2 bobRes)] [carol]
  expectAbort "not covered by the given transferLegs" res

testSettleBatchRejectsWrongActors : Script ()
testSettleBatchRejectsWrongActors = do
  admin <- allocateParty "SettleWrongActorsAdmin"
  alice <- allocateParty "SettleWrongActorsAlice"
  bob <- allocateParty "SettleWrongActorsBob"
  carol <- allocateParty "SettleWrongActorsCarolExecutor"
  factoryCid <- coinFactorySetup admin
  let instrumentId = InstrumentId with admin, id = "COIN-SETTLE-WRONGACTORS"
  coinCid <- mintCoinV2 factoryCid admin instrumentId alice 0.006
  let settlement = mkSettlement [carol] "settlement-wrongactors"
      aliceSpec = mkSpec admin alice [mkLeg "leg-0" AV2.SenderSide bob 0.006 "COIN-SETTLE-WRONGACTORS"]
      bobSpec = mkSpec admin bob [mkLeg "leg-0" AV2.ReceiverSide alice 0.006 "COIN-SETTLE-WRONGACTORS"]
  aliceRes <- allocate factoryCid admin alice settlement aliceSpec [coinCid]
  bobRes <- allocate factoryCid admin bob settlement bobSpec []
  let transferLegs = [AV2.TransferLeg with
        transferLegId = "leg-0", sender = basicAccount alice, receiver = basicAccount bob
        amount = 0.006, instrumentId = "COIN-SETTLE-WRONGACTORS", meta = emptyMetadata]
  res <- trySettleBatch factoryCid admin settlement transferLegs
    [finalized (theAllocationCidV2 aliceRes), finalized (theAllocationCidV2 bobRes)] [alice]
  case res of
    Left _ -> pure ()
    Right _ -> abort "expected non-executor submitter to fail"

----------------------------------------------------------------------
-- Cancel / Withdraw
----------------------------------------------------------------------

testCancelReturnsAllLockedFundsAcrossInstruments : Script ()
testCancelReturnsAllLockedFundsAcrossInstruments = do
  admin <- allocateParty "CancelV2Admin"
  alice <- allocateParty "CancelV2Alice"
  bob <- allocateParty "CancelV2Bob"
  carol <- allocateParty "CancelV2Carol"
  dave <- allocateParty "CancelV2DaveExecutor"
  factoryCid <- coinFactorySetup admin
  let instA = InstrumentId with admin, id = "COIN-CANCELV2-A"
      instB = InstrumentId with admin, id = "COIN-CANCELV2-B"
  coinA <- mintCoinV2 factoryCid admin instA alice 0.01
  coinB <- mintCoinV2 factoryCid admin instB alice 0.02
  let settlement = mkSettlement [dave] "settlement-cancel"
      spec = mkSpec admin alice
        [ mkLeg "leg-a" AV2.SenderSide bob 0.01 "COIN-CANCELV2-A"
        , mkLeg "leg-b" AV2.SenderSide carol 0.02 "COIN-CANCELV2-B"
        ]
  res <- allocate factoryCid admin alice settlement spec [coinA, coinB]
  let allocCid = theAllocationCidV2 res
  cancelRes <- submit dave do exerciseCmd allocCid AV2.Allocation_Cancel with actors = [dave], extraArgs = emptyExtraArgs
  cancelRes.output === AV2.AllocationResult_Cancelled
  case TextMap.lookup "COIN-CANCELV2-A" cancelRes.authorizerHoldingCids of
    Some [cid] -> do
      Some c <- queryContractId admin (coerceContractId @HoldingV2.Holding @Coin cid)
      c.amount === 0.01
    other -> abort ("expected instrument A returned, got: " <> show other)
  case TextMap.lookup "COIN-CANCELV2-B" cancelRes.authorizerHoldingCids of
    Some [cid] -> do
      Some c <- queryContractId admin (coerceContractId @HoldingV2.Holding @Coin cid)
      c.amount === 0.02
    other -> abort ("expected instrument B returned, got: " <> show other)

