    other -> abort ("expected Failed, got: " <> show other)
  archived <- queryContractId admin (coerceContractId @TIV2.TransferInstruction @CoinTransferInstruction instrCid)
  archived === None
  submitMustFail bob do
    exerciseCmd instrCid TIV2.TransferInstruction_Reject with actors = [bob], extraArgs = emptyExtraArgs

